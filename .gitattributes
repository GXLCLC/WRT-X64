# 强制所有文本文件使用 LF 行尾。
# 本仓库的产物全部在 Linux（GitHub Actions ubuntu-24.04）上执行：
# shell 脚本若带 CRLF 会直接报 "bad interpreter: ...bash^M"，
# 因此这里统一归一化为 LF，避免 Windows 检出时被转换。
* text=auto eol=lf

# 显式声明（保持可读性）
*.sh        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.config    text eol=lf
*.txt       text eol=lf
*.md        text eol=lf
*.json      text eol=lf

# 预置配置文件（部分无扩展名，统一按 LF 归一化）
preset/**   text eol=lf
