# ================================================================
# .gitattributes
#
# 【为什么需要这个文件】
#   所有脚本最终都要在 GitHub 的 Linux Runner 上执行。如果某个脚本
#   被以 CRLF 提交，#!/usr/bin/env bash 这一行末尾会带一个 \r，
#   Linux 内核找不到 "/usr/bin/env bash\r" 这个解释器，会直接报
#   "/usr/bin/env: bash\r: No such file or directory" —— 而且报错
#   信息看起来完全不像行尾问题，极难排查。
#
#   这里显式声明：脚本、编译配置、工作流 YAML 一律以 LF 存库、
#   以 LF 检出，不受各人本地 core.autocrlf 设置影响。
# ================================================================

# 脚本：强制 LF（在 Linux Runner 上执行，绝不能带 CR）
*.sh            text eol=lf
files/sbin/*    text eol=lf

# files/ 下全部是打进固件的文本配置（uci 配置、YAML、脚本），
# 一律 LF：uci 解析器同样不认 CR，带 CR 的配置会读不出值。
files/**         text eol=lf

# 文档：统一 LF，避免不同系统检出后产生无意义的行尾 diff
*.md            text eol=lf


# 编译配置：OpenWrt 的 .config 解析器不认 CR
*.config        text eol=lf

# 工作流与 YAML 配置
*.yml           text eol=lf
*.yaml          text eol=lf

# 二进制资源按原样处理，不做任何转换
*.gz            binary
*.img           binary
*.png           binary
*.jpg           binary
