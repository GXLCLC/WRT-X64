# ==================== 目标架构 ====================
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

# ==================== 镜像格式（仅 IMG） ====================
# 生成 squashfs-combined-efi 格式的 IMG 镜像
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_IMAGES_ISO=n
CONFIG_TARGET_IMAGES_VHDX=n
CONFIG_TARGET_IMAGES_VMDK=n
# 内核分区 32MB，RootFS 分区 2048MB（2G overlay 可写空间）
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_TARGET_ROOTFS_PARTSIZE=2048

# ==================== LuCI 核心 ====================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-istore=y
CONFIG_PACKAGE_luci-app-quickstart=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-docker=y
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_luci-app-samba4=y

# ==================== 主题：Argon ====================
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

# ==================== SmartDNS ====================
CONFIG_PACKAGE_smartdns=y
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_luci-i18n-smartdns-zh-cn=y

# ==================== DDNSTO ====================
CONFIG_PACKAGE_luci-app-ddns=y

# ==================== AdGuardHome ====================
CONFIG_PACKAGE_adguardhome=y
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_luci-i18n-adguardhome-zh-cn=y

# ==================== OAF 应用过滤 ====================
CONFIG_PACKAGE_luci-app-oaf=y
CONFIG_PACKAGE_kmod-oaf=y
CONFIG_PACKAGE_appfilter=y

# ==================== TurboAcc 加速 ====================
CONFIG_PACKAGE_luci-app-turboacc=y

# ==================== Mwan3 多拨 ====================
CONFIG_PACKAGE_mwan3=y
CONFIG_PACKAGE_luci-app-mwan3=y
CONFIG_PACKAGE_luci-i18n-mwan3-zh-cn=y

# ==================== nlbwmon 带宽监控 ====================
CONFIG_PACKAGE_nlbwmon=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y

# ==================== EasyTier ====================
CONFIG_PACKAGE_luci-app-easytier=y
CONFIG_PACKAGE_kmod-tun=y

# ==================== UPnP ====================
CONFIG_PACKAGE_miniupnpd=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y

# ==================== ttyd 终端 ====================
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y

# ==================== 网卡驱动 ====================
# 英特尔 i211 网卡（igb 驱动，支持 i210/i211 系列）
CONFIG_PACKAGE_kmod-igb=y
# 英特尔 e1000e 千兆系列
CONFIG_PACKAGE_kmod-e1000e=y
# 英特尔 ixgbe 万兆系列
CONFIG_PACKAGE_kmod-ixgbe=y
# 瑞昱系列有线网卡
CONFIG_PACKAGE_kmod-r8169=y
CONFIG_PACKAGE_kmod-tg3=y

# USB 驱动
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y

# USB 网卡驱动
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-asix=y
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y
CONFIG_PACKAGE_kmod-usb-net-rtl8150=y

# ==================== 存储与 Docker ====================
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-ntfs=y
CONFIG_PACKAGE_kmod-fs-vfat=y

# ==================== 系统工具 ====================
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_openssh-sftp-server=y
