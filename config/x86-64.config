# ============================================================
#  ImmortalWrt x86_64 云编译固件配置
#  * 仅编译 x86_64 架构，输出 squashfs combined IMG 镜像
#  * make defconfig 自动补全依赖；不存在的包自动剔除
# ============================================================

# ---------------- 目标平台 ----------------
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y

# ---------------- 镜像输出格式 ----------------
# squashfs 只读系统 + overlay 可写分区（支持恢复出厂设置）
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# 关闭 ext4 rootfs，仅保留 squashfs
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
# GRUB 引导（同时产出 BIOS 与 EFI 两个 combined 镜像）
CONFIG_GRUB_IMAGES=y
CONFIG_EFI_IMAGES=y
# 仅输出 IMG：关闭 ISO / VMDK / VHDX 等其他格式
# CONFIG_ISO_IMAGES is not set
# CONFIG_VMDK_IMAGES is not set
# CONFIG_VHDI_IMAGES is not set
# 镜像 gzip 压缩，减小下载体积
CONFIG_TARGET_IMAGES_GZIP=y
# rootfs 分区大小(MB) = squashfs 只读层 + overlay 可写层
# 固件本体约占 1GB，设 3072MB 可保证 overlay 可写空间约 2GB
CONFIG_TARGET_ROOTFS_PARTSIZE=3072

# ---------------- 系统基础 ----------------
# LuCI Web 管理界面 + 旧版 API 兼容层（部分第三方插件需要）
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
# 引导程序
CONFIG_PACKAGE_grub2=y
CONFIG_PACKAGE_grub2-efi=y
# DNS：dnsmasq-full（OpenClash / SmartDNS 必需，禁用精简版）
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y
# 证书与下载工具（插件运行时依赖）
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_curl=y

# ---------------- 关键内核模块 ----------------
# TUN 设备（EasyTier / OpenClash TUN 模式必需）
CONFIG_PACKAGE_kmod-tun=y
# nftables 透明代理支持（OpenClash 透明代理依赖）
CONFIG_PACKAGE_kmod-nft-tproxy=y

# ---------------- 有线网卡驱动 ----------------
# Intel 系列（老款 e1000 / e1000e / igb / igc(i225\i226) / ixgbe 万兆）
CONFIG_PACKAGE_kmod-e1000=y
CONFIG_PACKAGE_kmod-e1000e=y
CONFIG_PACKAGE_kmod-igb=y
CONFIG_PACKAGE_kmod-igc=y
CONFIG_PACKAGE_kmod-ixgbe=y
# Realtek 系列 PCIe 有线网卡（8111 / 8168 / 8125 等）
CONFIG_PACKAGE_kmod-r8169=y

# ---------------- USB 控制器与存储驱动 ----------------
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb2-pci=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
# 挂载与文件系统（U 盘 / 移动硬盘）
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-vfat=y
# 字符集（正确显示中文文件名）
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_kmod-nls-utf8=y
# 磁盘工具
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_fdisk=y

# ---------------- USB 网卡驱动 ----------------
CONFIG_PACKAGE_kmod-usb-net=y
# ASIX 系列 USB 有线网卡（AX88772 等）
CONFIG_PACKAGE_kmod-usb-net-asix=y
# ASIX USB 3.0 千兆网卡（AX88179）
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y
# CDC 系列（虚拟化 USB 网卡 / 光猫）
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
# RNDIS（安卓手机 USB 共享网络）
CONFIG_PACKAGE_kmod-usb-net-rndis=y
# Qualcomm 4G/5G 模块拨号
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
# Realtek USB 网卡（RTL8150 百兆 / RTL8152\8153 千兆）
CONFIG_PACKAGE_kmod-usb-net-rtl8150=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y

# ---------------- 应用插件（均含中文翻译包） ----------------
# 1. SmartDNS 智能DNS（后端 + SmartDNS LuCI 管理界面）
CONFIG_PACKAGE_smartdns=y
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_luci-i18n-smartdns-zh-cn=y

# 2. DDNSTO 远程访问（后端 + LuCI 界面，前端后端双仓库拉取）
CONFIG_PACKAGE_ddnsto=y
CONFIG_PACKAGE_luci-app-ddnsto=y
CONFIG_PACKAGE_luci-i18n-ddnsto-zh-cn=y

# 3. AdGuardHome 去广告（LuCI 界面内置 53 端口重定向功能）
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_luci-i18n-adguardhome-zh-cn=y

# 4. OAF 应用过滤（内核模块 + LuCI 界面，按应用类型管控）
CONFIG_PACKAGE_kmod-oaf=y
CONFIG_PACKAGE_luci-app-oaf=y
CONFIG_PACKAGE_luci-i18n-oaf-zh-cn=y

# 5. Turbo ACC 软硬件加速
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_luci-i18n-turboacc-zh-cn=y

# 6. mwan3 多 WAN 负载均衡与故障转移
CONFIG_PACKAGE_mwan3=y
CONFIG_PACKAGE_luci-app-mwan3=y
CONFIG_PACKAGE_luci-i18n-mwan3-zh-cn=y

# 7. Argon 主题（默认主题）+ 主题配置器
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y

# 8. 带宽监控（bandwidthd 流量图形监控）
CONFIG_PACKAGE_bandwidthd=y
CONFIG_PACKAGE_luci-app-bandwidthd=y
CONFIG_PACKAGE_luci-i18n-bandwidthd-zh-cn=y

# 9. EasyTier 去中心化内网穿透
CONFIG_PACKAGE_easytier=y
CONFIG_PACKAGE_luci-app-easytier=y
CONFIG_PACKAGE_luci-i18n-easytier-zh-cn=y

# 10. OpenClash（本固件唯一代理插件，不再集成其他任何代理插件）
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-i18n-openclash-zh-cn=y
