# ============================================================================
# ImmortalWrt 24.10 X86_64 定制固件配置（种子配置）
# 说明：本文件为种子配置，编译时经 make defconfig 自动展开全部依赖；
#       使用者可直接编辑本文件灵活增减插件，无需改动工作流。
# ============================================================================

# ---------- 目标平台：x86_64 通用设备 ----------
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

# ---------- 镜像格式：仅 squashfs（只读系统 + overlay 可写分区），不生成 ext4 ----------
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
# CONFIG_TARGET_ROOTFS_CPIOGZ is not set
# CONFIG_TARGET_ROOTFS_TARGZ is not set
CONFIG_TARGET_IMAGES_GZIP=y

# rootfs 分区总大小 2560MB：squashfs 只读系统约 300~500MB，
# 剩余约 2GB+ 作为 overlay 可写空间（在线安装软件包 / 缓存 / 保存配置）
CONFIG_TARGET_ROOTFS_PARTSIZE=2560

# ---------- GRUB 引导：同时支持 BIOS 与 EFI 启动 ----------
CONFIG_GRUB_IMAGES=y
CONFIG_GRUB_EFI_IMAGES=y

# ---------- LuCI 界面：内置中文（自动为全部插件生成中文语言包 zh-Hans）----------
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y

# ---------- 默认主题：Argon 及其配置器 ----------
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

# ---------- DNS 加速：SmartDNS（含 SmartDNS Luci 管理界面）----------
CONFIG_PACKAGE_smartdns=y
CONFIG_PACKAGE_luci-app-smartdns=y

# ---------- AdGuardHome（后端用官方 feed，Luci 界面用 kenzok8 版，可显示 Web UI 端口）----------
CONFIG_PACKAGE_adguardhome=y
CONFIG_PACKAGE_luci-app-adguardhome=y

# ---------- DDNSTO 远程控制（前端 + 后端，由 diy-part2 从 linkease 仓库拉取）----------
CONFIG_PACKAGE_ddnsto=y
CONFIG_PACKAGE_luci-app-ddnsto=y

# ---------- OAF 应用过滤（luci-app-oaf + kmod-oaf 内核模块）----------
CONFIG_PACKAGE_kmod-oaf=y
CONFIG_PACKAGE_luci-app-oaf=y

# ---------- Turbo ACC 网络加速（具体加速特性由构建系统按内核版本自动匹配）----------
CONFIG_PACKAGE_luci-app-turboacc=y

# ---------- Mwan3 多线多拨负载均衡 ----------
CONFIG_PACKAGE_mwan3=y
CONFIG_PACKAGE_luci-app-mwan3=y

# ---------- nlbwmon 带宽监控 ----------
CONFIG_PACKAGE_nlbwmon=y
CONFIG_PACKAGE_luci-app-nlbwmon=y

# ---------- EasyTier 内网穿透（luci 界面 + easytier 后端）----------
CONFIG_PACKAGE_easytier=y
CONFIG_PACKAGE_luci-app-easytier=y

# ---------- OpenClash（唯一代理插件，不集成其他任何代理类软件）----------
CONFIG_PACKAGE_luci-app-openclash=y

# ---------- dnsmasq-full：OpenClash / SmartDNS 需要完整版 dnsmasq 支持 ----------
CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq is not set

# ---------- 内核模块：USB 控制器与 USB 存储 ----------
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb2-pci=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y

# ---------- 内核模块：USB 网卡（ASIX / AX88179 / RTL8152 / RNDIS 等）----------
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-asix=y
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y

# ---------- 内核模块：常见有线网卡（互不冲突，按需选择主流型号）----------
CONFIG_PACKAGE_kmod-igb=y        # Intel i210/i211 千兆网卡
CONFIG_PACKAGE_kmod-igbvf=y      # Intel 82576 VF
CONFIG_PACKAGE_kmod-e1000e=y     # Intel i219/i218 板载网卡
CONFIG_PACKAGE_kmod-e1000=y      # Intel 82574 等老款网卡
CONFIG_PACKAGE_kmod-r8169=y      # 瑞昱 RTL8111/8168 系列（最常见板载网卡）
CONFIG_PACKAGE_kmod-tg3=y        # 博通 BCM570x 系列
CONFIG_PACKAGE_kmod-forcedeth=y  # NVIDIA nForce 系列
CONFIG_PACKAGE_kmod-8139too=y    # 瑞昱 RTL8139 老款百兆网卡（与 8139cp 互斥，仅选其一）
