# ============================================================================
# OpenWrt x86_64 自定义固件配置（config/x86_64.config）
#
# 使用方法：
#   1. 直接在本文件中增删「CONFIG_PACKAGE_包名=y」一行即可增删插件
#   2. 改完提交到仓库，然后到 GitHub Actions 页面手动触发编译
#
# 注意事项：
#   - 包名写错不会报错，只会静默失效；编译日志「加载自定义固件配置」步骤
#     会打印最终生效的插件清单，请务必核对
#   - 不确定包名时可先在本地 make menuconfig 查询，或搜索 lede 仓库
#   - 本配置默认不含任何代理类插件
# ============================================================================

# ---------------- 目标平台：x86_64 ----------------
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

# ---------------- 镜像设置：仅 IMG 格式，Overlay 预留 2G ----------------
# 生成 BIOS 传统启动固件 openwrt-x86-64-generic-squashfs-combined.img.gz
CONFIG_GRUB_IMAGES=y
# 生成 UEFI 新式启动固件 openwrt-x86-64-generic-squashfs-combined-efi.img.gz
CONFIG_GRUB_EFI_IMAGES=y
# 镜像用 gzip 压缩，显著缩小下载体积
CONFIG_TARGET_IMAGES_GZIP=y
# 以下格式一律关闭：只要 IMG，不要 VMDK（VMware）/VHDX（Hyper-V）等格式
# CONFIG_ISO_IMAGES is not set
# CONFIG_QCOW2_IMAGES is not set
# CONFIG_VDI_IMAGES is not set
# CONFIG_VMDK_IMAGES is not set
# CONFIG_VHDX_IMAGES is not set
# 内核分区大小（MB），适当加大防止内核与引导文件放不下
CONFIG_TARGET_KERNEL_PARTSIZE=64
# 根文件系统分区大小（MB）= 2048MB，即 Overlay 预留 2G 空间
CONFIG_TARGET_ROOTFS_PARTSIZE=2048
# 使用 squashfs（可恢复出厂设置），不使用 ext4 单分区格式
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_EXT4FS is not set

# ---------------- LuCI 主题：argon 设为默认 ----------------
CONFIG_PACKAGE_luci-theme-argon=y
# 关闭 bootstrap 主题，使 argon 成为默认主题
# CONFIG_PACKAGE_luci-theme-bootstrap is not set

# ---------------- 常用插件（来自 lede 官方 feeds，包名已验证） ----------------
# SmartDNS：DNS 优选加速
CONFIG_PACKAGE_luci-app-smartdns=y
# AdGuardHome：全屋广告过滤
CONFIG_PACKAGE_luci-app-adguardhome=y
# TurboACC：网络加速（BBR / Flow Offload / DNS 缓存等）
CONFIG_PACKAGE_luci-app-turboacc=y
# MWAN3：多 WAN 负载均衡与故障切换
CONFIG_PACKAGE_luci-app-mwan3=y
# nlbwmon：带宽/流量监控
CONFIG_PACKAGE_luci-app-nlbwmon=y

# ---------------- 常用插件（第三方官方源，由工作流自动拉取源码） ----------------
# DDNSTO：内网穿透远程访问（linkease/ddnsto-openwrt-package）
CONFIG_PACKAGE_luci-app-ddnsto=y
# OAF 应用过滤：OpenAppFilter 家长控制/应用过滤（destan19/OpenAppFilter），
# 选中 luci-app-oaf 会自动带上内核模块 oaf 和特征库 open-app-filter
CONFIG_PACKAGE_luci-app-oaf=y
# EasyTier：去中心化内网穿透/异地组网（EasyTier/luci-app-easytier），
# easytier 为核心程序包，luci-app-easytier 为管理界面，两者都需要
CONFIG_PACKAGE_easytier=y
CONFIG_PACKAGE_luci-app-easytier=y

# ---------------- 基础 USB 驱动 ----------------
# USB 2.0 / 3.0 主机控制器、U 盘存储、UAS 加速、USB 键鼠 HID
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb-hid=y

# ---------------- 网卡驱动：瑞昱 Realtek ----------------
# 8139cp/8139too：老款百兆 PCI 网卡
CONFIG_PACKAGE_kmod-8139cp=y
CONFIG_PACKAGE_kmod-8139too=y
# r8169：瑞昱千兆 PCIe 网卡（内核自带驱动）
CONFIG_PACKAGE_kmod-r8169=y
# r8125：瑞昱 2.5G 网卡（如 RTL8125，厂商驱动）
CONFIG_PACKAGE_kmod-r8125=y
# r8126：瑞昱 5G 网卡（如 RTL8126，厂商驱动）
CONFIG_PACKAGE_kmod-r8126=y
# r8152：瑞昱 USB 网卡（如 RTL8152/8153）
CONFIG_PACKAGE_kmod-r8152=y

# ---------------- 网卡驱动：英特尔 Intel ----------------
# e1000：老款千兆（8254x 系列）
CONFIG_PACKAGE_kmod-e1000=y
# e1000e：主流千兆 PCIe（82574/82576 等）
CONFIG_PACKAGE_kmod-e1000e=y
# igb：服务器千兆（82575/82576/I210/I350 等）
CONFIG_PACKAGE_kmod-igb=y
# igc：2.5G 网卡（I225/I226，软路由常见）
CONFIG_PACKAGE_kmod-igc=y
# ixgbe：万兆网卡（82599/X540/X710 等）
CONFIG_PACKAGE_kmod-ixgbe=y
