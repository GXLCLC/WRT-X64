# ============================================================================
# ImmortalWrt 24.10 X86_64 云编译固件配置
# ----------------------------------------------------------------------------
# 使用说明：
#   1. 本文件为仓库内置固件配置，直接修改本文件即可灵活增减插件；
#   2. make defconfig 会自动补全依赖，并自动忽略当前源码中不存在的软件包；
#   3. 所有 LuCI 插件的 zh-cn 中文语言包由工作流自动同步勾选，无需逐个添加；
#   4. 内核模块按需集成（USB / 常见有线网卡），若个别 kmod 在当前源码分支
#      不存在或存在冲突，defconfig 会自动忽略，不影响编译（遵循
#      “冲突时优先最新 kmod、非必需不强装”的兼容性原则）。
# ============================================================================

# ------------------------------- 目标平台 ---------------------------------
# 仅编译 X86_64 架构（generic 通用设备）
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

# ---------------------- 镜像格式（仅 squashfs + 仅 IMG）--------------------
# 根文件系统仅使用 squashfs（支持系统恢复出厂设置）
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# 禁用 ext4 根文件系统
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
# 生成 BIOS / UEFI 双启动的 squashfs-combined IMG 镜像
CONFIG_GRUB_IMAGES=y
CONFIG_GRUB_EFI_IMAGES=y
# 禁用 VMDK / VHDX 等虚拟机磁盘格式，仅输出 IMG 镜像（需求要求）
# CONFIG_VMDK_IMAGES is not set
# CONFIG_VHDX_IMAGES is not set
# IMG 镜像启用 gzip 压缩（GitHub Releases 单文件限制 2GB，压缩后便于上传发布）
CONFIG_TARGET_IMAGES_GZIP=y

# ----------------------------- 分区大小设置 -------------------------------
# 内核分区 64MB（预留足够空间容纳内核与模块）
CONFIG_TARGET_KERNEL_PARTSIZE="64"
# 根分区 2560MB：扣除 squashfs 只读系统部分（约 300~500MB）后，
# 剩余约 2GB 作为 overlay 可写分区空间（满足“额外增加 2G overlay”需求）
# 如后续插件增多导致 squashfs 变大，可相应调大此值
CONFIG_TARGET_ROOTFS_PARTSIZE="2560"

# ------------------------------ 系统基础 ----------------------------------
# LuCI 管理界面（含防火墙页面等基础组件）
CONFIG_PACKAGE_luci=y
# luci-compat 旧版应用兼容层（保障 DDNSTO 等第三方旧框架插件正常运行）
CONFIG_PACKAGE_luci-compat=y
# LuCI 基础界面中文（两种语言包命名写法均保留，defconfig 自动忽略不存在的）
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-base-zh-Hans=y
# ImmortalWrt 默认 DNS 组件为 dnsmasq-full，满足 OpenClash 的 ipset/nftset 依赖
CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq is not set

# ------------------------------ 默认主题 ----------------------------------
# Argon 主题（由 scripts/system-config.sh 固化为系统默认主题）
CONFIG_PACKAGE_luci-theme-argon=y
# Argon 主题在线配置工具
CONFIG_PACKAGE_luci-theme-argon-config=y

# --------------------------- 需求集成插件清单 ------------------------------
# SmartDNS：DNS 分流加速（含 SmartDNS 的 LuCI 管理界面）
CONFIG_PACKAGE_smartdns=y
CONFIG_PACKAGE_luci-app-smartdns=y

# DDNSTO：远程控制内网（前端 LuCI 页面 + 后端程序由脚本按需拉取）
CONFIG_PACKAGE_ddnsto=y
CONFIG_PACKAGE_luci-app-ddnsto=y

# AdGuardHome：去广告（使用 kenzok8 第三方仓库版本，核心程序 + LuCI 面板
# 一并编译，面板可显示 AdGuardHome Web UI 端口信息）
CONFIG_PACKAGE_adguardhome=y
CONFIG_PACKAGE_luci-app-adguardhome=y

# OAF 应用过滤：open-app-filter 内核模块 + LuCI 界面（独立仓库源码编译）
CONFIG_PACKAGE_kmod-oaf=y
CONFIG_PACKAGE_luci-app-oaf=y

# TurboACC：网络加速（NAT 硬件/软件加速开关管理）
CONFIG_PACKAGE_luci-app-turboacc=y

# Mwan3：多 WAN 负载均衡
CONFIG_PACKAGE_mwan3=y
CONFIG_PACKAGE_luci-app-mwan3=y

# Nlbwmon：带宽监控（按主机统计流量）
CONFIG_PACKAGE_nlbwmon=y
CONFIG_PACKAGE_luci-app-nlbwmon=y

# EasyTier：去中心化内网穿透组网（第三方独立仓库）
CONFIG_PACKAGE_luci-app-easytier=y

# OpenClash：唯一集成的代理插件（本配置不包含其他任何代理类插件）
CONFIG_PACKAGE_luci-app-openclash=y

# --------------------------- 内核模块----------------------------------------
# USB 主机控制器驱动（内置 USB 支持：xHCI / EHCI / OHCI / UHCI）
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb2-pci=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb-uhci=y

# USB 有线网卡驱动（RTL8152/8150、AX88179、ASIX、CDC、RNDIS、QMI 等常见型号）
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-asix=y
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-eem=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-cdc-subset=y
CONFIG_PACKAGE_kmod-usb-net-dm9601-ether=y
CONFIG_PACKAGE_kmod-usb-net-kaweth=y
CONFIG_PACKAGE_kmod-usb-net-mcs7830=y
CONFIG_PACKAGE_kmod-usb-net-pegasus=y
CONFIG_PACKAGE_kmod-usb-net-rtl8150=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-sierra-net=y

# PCIe / PCI 有线网卡驱动（覆盖 Intel 与 Realtek 常见型号，需求指定 I211 / RTL8111）
CONFIG_PACKAGE_kmod-e1000=y          # Intel 82540 / 82545 等老型号
CONFIG_PACKAGE_kmod-e1000e=y         # Intel 82563 / 82574 / I217 等
CONFIG_PACKAGE_kmod-igb=y            # Intel I210 / I211（含 82575 / 82576）
CONFIG_PACKAGE_kmod-igc=y            # Intel I225 / I226 2.5G（源码无此包时自动忽略）
CONFIG_PACKAGE_kmod-r8169=y          # Realtek RTL8111 / 8168 / 8125 系列
CONFIG_PACKAGE_kmod-forcedeth=y      # NVIDIA nForce 集成网卡

# --------------------------- 可自行增减区域 -------------------------------
# 按同样格式追加或删除 “CONFIG_PACKAGE_xxx=y” 即可完成定制，例如：
# CONFIG_PACKAGE_htop=y
# CONFIG_PACKAGE_luci-app-ttyd=y
