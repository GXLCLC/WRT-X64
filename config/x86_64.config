# ============================================================================
#  ImmortalWrt 24.10 X86_64 固件配置文件
#  使用说明：
#    1. 增减插件：直接增删对应的 CONFIG_PACKAGE_xxx=y 配置行
#    2. 修改后提交推送，重新运行 Actions 即可生效
#    3. 不存在的包会在 make defconfig 阶段被自动清理，不会导致编译失败
#    4. 部分网卡驱动在 x86_64 内核已内置，对应 kmod 选项会被自动忽略
# ============================================================================

# ------------------------------ 目标平台 ------------------------------
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

# ---------------------- 镜像格式：仅 squashfs combined ----------------------
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_IMAGES_GZIP=y
# 不生成 ext4 镜像
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
# 不生成 VMDK / VDI / VHDX / GPT 等格式，仅保留 IMG 镜像
# CONFIG_VMDK_IMAGES is not set
# CONFIG_VDI_IMAGES is not set
# CONFIG_VHDX_IMAGES is not set
# CONFIG_GPT_IMAGES is not set

# ------------------------------ 分区大小 ------------------------------
# 内核分区 32MB（容纳较多内置 kmod 驱动）
CONFIG_TARGET_KERNEL_PARTSIZE=32
# rootfs 分区 2048MB（扣除 squashfs 只读层后作为可写 overlay，
# 用于运行时安装软件包、存放缓存与保存配置；如需更大可写空间可调大此值）
CONFIG_TARGET_ROOTFS_PARTSIZE=2048

# ------------------------------ LuCI 基础 ------------------------------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y

# ------------------------ Argon 主题（设为系统默认）------------------------
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y

# ------------------------ SmartDNS（含管理界面 UI）------------------------
CONFIG_PACKAGE_smartdns=y
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_luci-i18n-smartdns-zh-cn=y

# ------------------- DDNSTO 远程访问（前端 + 后端 + 中文）-------------------
CONFIG_PACKAGE_ddnsto=y
CONFIG_PACKAGE_luci-app-ddnsto=y
CONFIG_PACKAGE_luci-i18n-ddnsto-zh-cn=y

# ------- AdGuardHome（kenzok8 版 LuCI 界面，支持 Web UI 端口显示/设置）-------
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_luci-i18n-adguardhome-zh-cn=y

# ------------------ OAF 应用过滤（luci-app-oaf + kmod-oaf）------------------
CONFIG_PACKAGE_luci-app-oaf=y
CONFIG_PACKAGE_kmod-oaf=y
CONFIG_PACKAGE_luci-i18n-oaf-zh-cn=y

# ------------------------------ TurboACC 加速 ------------------------------
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_luci-i18n-turboacc-zh-cn=y

# ------------------------------ Mwan3 多线负载 ------------------------------
CONFIG_PACKAGE_mwan3=y
CONFIG_PACKAGE_luci-app-mwan3=y
CONFIG_PACKAGE_luci-i18n-mwan3-zh-cn=y

# --------------------------- nlbwmon 带宽监控 ---------------------------
CONFIG_PACKAGE_nlbwmon=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y

# --------------------------- EasyTier 内网穿透 ---------------------------
CONFIG_PACKAGE_easytier=y
CONFIG_PACKAGE_luci-app-easytier=y
CONFIG_PACKAGE_luci-i18n-easytier-zh-cn=y

# --------------- OpenClash（唯一内置代理插件，界面自带中文）---------------
CONFIG_PACKAGE_luci-app-openclash=y
# OpenClash 依赖完整版 dnsmasq（ipset/nftset 支持）
CONFIG_PACKAGE_dnsmasq-full=y

# ------------------------ USB 驱动（内置 USB 支持）------------------------
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y

# ------------------------ USB 网卡驱动 ------------------------
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_kmod-usb-net-rtl8150=y
CONFIG_PACKAGE_kmod-usb-net-asix=y
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y

# ------------------------ 有线网卡驱动（常见型号）------------------------
# Intel 82540/82545/E1000 系列（虚拟化环境常用）
CONFIG_PACKAGE_kmod-e1000=y
# Intel 82563/82574/I219 系列
CONFIG_PACKAGE_kmod-e1000e=y
# Intel I210/I211 系列
CONFIG_PACKAGE_kmod-igb=y
# Intel I225/I226 2.5G 系列
CONFIG_PACKAGE_kmod-igc=y
# Intel X710/XL710 10G 系列（服务器/PVE 常见）
CONFIG_PACKAGE_kmod-i40e=y
# Realtek RTL8111/8168 系列
CONFIG_PACKAGE_kmod-r8169=y

# ------------------------ 虚拟化网卡驱动（PVE/ESXi 场景）------------------------
CONFIG_PACKAGE_kmod-virtio-net=y
CONFIG_PACKAGE_kmod-virtio-blk=y
CONFIG_PACKAGE_kmod-vmxnet3=y

# ------------------------ 存储与文件系统（USB 挂载用）------------------------
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-nls-utf8=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_fdisk=y

# ------------------------ 常用系统工具（可选，可按需删除）------------------------
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_iperf3=y
