# ==============================================================================
# ImmortalWrt 编译配置文件
# 架构：X86_64
# 镜像格式：squashfs combined（仅输出 IMG，不生成 VHDX/VMDK）
# overlay 分区：编译后由后置脚本扩容至 2G 可写空间
# --------------------------------------------------------------------------------
# 使用说明：
#   - 本文件为用户可修改的编译配置，勾选/取消对应配置项即可增减插件
#   - 执行 make defconfig 时会自动补全其余未列出的依赖项
#   - =y 表示编入固件；=m 表示编译为独立 ipk 包；# is not set 表示禁用
# ==============================================================================

# ==============================================================================
# 目标平台配置（X86_64 架构）
# ImmortalWrt x86/64 的 generic 设备 Kconfig 符号名为
# CONFIG_TARGET_x86_64_DEVICE_generic（注意是小写 generic，非 Generic）
# ==============================================================================
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

# ==============================================================================
# 镜像与分区配置
# ==============================================================================
# squashfs 格式 rootfs（只读压缩文件系统，支持 overlay 可写层）
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# 关闭 ext4 rootfs（仅保留 squashfs）
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
# 关闭 JFFS2 格式
# CONFIG_TARGET_ROOTFS_JFFS2FS is not set
# 关闭 tar.gz 格式
# CONFIG_TARGET_ROOTFS_TARGZ is not set
# 关闭 cpio 格式
# CONFIG_TARGET_ROOTFS_CPIOGZ is not set

# rootfs 分区基础大小（MB），后置脚本 resize_overlay.sh 会扩容至 2G
CONFIG_TARGET_ROOTFS_PARTSIZE=160
# boot 分区大小（MB）
CONFIG_TARGET_KERNEL_PARTSIZE=32

# 生成 combined 镜像（内核+rootfs 合一）
CONFIG_TARGET_IMAGES=y
# gzip 压缩镜像，减小体积
CONFIG_TARGET_IMAGES_GZIP=y
# 关闭 VMDK 镜像（不生成）
# CONFIG_VMDK_IMAGES is not set
# 关闭 VHDX 镜像（不生成）
# CONFIG_VHDX_IMAGES is not set
# 关闭 QEMU 镜像（不生成）
# CONFIG_QEMU_IMAGES is not set

# ==============================================================================
# USB 驱动（核心 + 各类 USB 主机控制器）
# ==============================================================================
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb2-pci=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb-uhci=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-usb-printer=y
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-wwan=y

# ==============================================================================
# USB 网卡驱动（常见 USB 转以太网芯片）
# ==============================================================================
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-asix=y
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y
CONFIG_PACKAGE_kmod-usb-net-cdc-eem=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-cdc-subset=y
CONFIG_PACKAGE_kmod-usb-net-dm9601-ether=y
CONFIG_PACKAGE_kmod-usb-net-hso=y
CONFIG_PACKAGE_kmod-usb-net-ipheth=y
CONFIG_PACKAGE_kmod-usb-net-kaweth=y
CONFIG_PACKAGE_kmod-usb-net-mcs7830=y
CONFIG_PACKAGE_kmod-usb-net-pegasus=y
CONFIG_PACKAGE_kmod-usb-net-pl=y
CONFIG_PACKAGE_kmod-usb-net-rtl8150=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_kmod-usb-net-smsc95xx=y

# ==============================================================================
# 英特尔系列有线网卡驱动
# ==============================================================================
CONFIG_PACKAGE_kmod-e1000=y
CONFIG_PACKAGE_kmod-e1000e=y
CONFIG_PACKAGE_kmod-igb=y
CONFIG_PACKAGE_kmod-igbvf=y
CONFIG_PACKAGE_kmod-ixgbe=y
CONFIG_PACKAGE_kmod-ixgbevf=y
CONFIG_PACKAGE_kmod-i40e=y
CONFIG_PACKAGE_kmod-igc=y

# ==============================================================================
# 瑞昱系列有线网卡驱动
# ==============================================================================
CONFIG_PACKAGE_kmod-r8169=y
CONFIG_PACKAGE_kmod-8139cp=y
CONFIG_PACKAGE_kmod-8139too=y

# ==============================================================================
# DHCP / DNS 基础服务
# dnsmasq-full 是增强版（支持 DNSSEC 等），SmartDNS/AdGuardHome/OpenClash 依赖它
# dnsmasq 与 dnsmasq-full 提供相同文件，只能选一个
# ==============================================================================
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_luci-proto-ipv6=y

# ==============================================================================
# ★ 用户指定插件清单 ★
# ==============================================================================

# 1. SmartDNS（智能 DNS）
CONFIG_PACKAGE_smartdns=y
CONFIG_PACKAGE_luci-app-smartdns=y

# 2. DDNSTO（内网穿透，DDNSTO 官方）
CONFIG_PACKAGE_ddnsto=y
CONFIG_PACKAGE_luci-app-ddnsto=y

# 3. AdGuardHome（广告拦截 DNS）
CONFIG_PACKAGE_adguardhome=y
CONFIG_PACKAGE_luci-app-adguardhome=y

# 4. OAF 应用过滤（luci-app-oaf）
CONFIG_PACKAGE_oaf=y
CONFIG_PACKAGE_luci-app-oaf=y

# 5. TurboAcc 网络加速
CONFIG_PACKAGE_luci-app-turboacc=y

# 6. mwan3（多 WAN 负载均衡 / 策略路由）
CONFIG_PACKAGE_mwan3=y
CONFIG_PACKAGE_luci-app-mwan3=y

# 7. Argon 主题（设置为系统默认主题，由 system_config.sh 完成切换）
CONFIG_PACKAGE_luci-theme-argon=y
# 8. argon-config（Argon 主题在线配置管理）
CONFIG_PACKAGE_luci-app-argon-config=y

# 9. 带宽监控（nlbwmon 网络带宽监控）
CONFIG_PACKAGE_nlbwmon=y
CONFIG_PACKAGE_luci-app-nlbwmon=y

# 10. EasyTier 内网穿透
CONFIG_PACKAGE_easytier=y
CONFIG_PACKAGE_luci-app-easytier=y

# 11. OpenClash（唯一代理插件）
CONFIG_PACKAGE_luci-app-openclash=y

# ==============================================================================
# 默认开启的网络协议支持
# ==============================================================================
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
