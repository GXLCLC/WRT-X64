# ==============================================================================
# OpenWrt 编译配置文件
# 架构：X86_64
# 镜像格式：squashfs combined
# overlay 分区：2G 可写空间
# --------------------------------------------------------------------------------
# 使用说明：
#   - 本文件为用户可修改的编译配置，勾选/取消对应配置项即可增减插件
#   - 执行 make defconfig 时会自动补全其余未列出的依赖项
#   - =y 表示编入固件；=m 表示编译为独立 ipk 包（不直接装入固件）；# is not set 表示禁用
# ==============================================================================

# ==============================================================================
# 目标平台配置（X86_64 架构）
# 注意：LEDE 中 x86/64 的 generic 设备 Kconfig 符号名为
#       CONFIG_TARGET_x86_64_DEVICE_generic（不是 Generic）
#       符号名错误会导致 make defconfig 重置整个配置并丢弃所有包选择
# ==============================================================================
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

# ==============================================================================
# 镜像与分区配置
# ==============================================================================
# squashfs 格式 rootfs
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# 关闭 ext4 等其他 rootfs 格式
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
# 关闭 JFFS2 格式
# CONFIG_TARGET_ROOTFS_JFFS2FS is not set
# 关闭 tar.gz 格式
# CONFIG_TARGET_ROOTFS_TARGZ is not set
# 关闭 cpio 格式
# CONFIG_TARGET_ROOTFS_CPIO is not set

# overlay 分区预留 2G（2048MB）可写空间，用于运行时安装软件包、存放缓存与配置
CONFIG_TARGET_ROOTFS_PARTSIZE="2048"

# 生成目标镜像（combined 镜像，内核+rootfs 合一）
CONFIG_TARGET_IMAGES=y
# 对镜像进行 gzip 压缩，减小体积
CONFIG_TARGET_IMAGES_GZIP=y
# 关闭 VMDK 镜像（不生成）
# CONFIG_VMDK_IMAGES is not set
# 关闭 VHDX 镜像（不生成）
# CONFIG_VHDX_IMAGES is not set
# 关闭 QEMU 镜像（不生成）
# CONFIG_QEMU_IMAGES is not set
# 仅输出 IMG 镜像文件

# ==============================================================================
# USB 驱动（核心 + 各类 USB 主机控制器）
# ==============================================================================
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb2-pci=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb-uhci=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-usb-printer=y
CONFIG_PACKAGE_kmod-usb-serial=y

# ==============================================================================
# USB 网卡驱动（支持 USB 转 RJ45 / USB 无线网卡等）
# ==============================================================================
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-asix=y
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y
CONFIG_PACKAGE_kmod-usb-net-cdcether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-eem=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-cdc-subset=y
CONFIG_PACKAGE_kmod-usb-net-dm9601-ether=y
CONFIG_PACKAGE_kmod-usb-net-hso=y
CONFIG_PACKAGE_kmod-usb-net-ipheth=y
CONFIG_PACKAGE_kmod-usb-net-kaweth=y
CONFIG_PACKAGE_kmod-usb-net-mcs7830=y
CONFIG_PACKAGE_kmod-usb-net-pegasus=y
CONFIG_PACKAGE_kmod-usb-net-pl=y
CONFIG_PACKAGE_kmod-usb-net-rtl8150=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_kmod-usb-net-smsc95xx=y

# ==============================================================================
# 英特尔（Intel）系列网卡驱动
# ==============================================================================
CONFIG_PACKAGE_kmod-e1000=y
CONFIG_PACKAGE_kmod-e1000e=y
CONFIG_PACKAGE_kmod-i40e=y
CONFIG_PACKAGE_kmod-igb=y
CONFIG_PACKAGE_kmod-igbvf=y
CONFIG_PACKAGE_kmod-igc=y
CONFIG_PACKAGE_kmod-ixgbe=y
CONFIG_PACKAGE_kmod-ixgbevf=y

# ==============================================================================
# 瑞昱（Realtek）系列网卡驱动
# ==============================================================================
CONFIG_PACKAGE_kmod-r8169=y
CONFIG_PACKAGE_kmod-8139cp=y
CONFIG_PACKAGE_kmod-8139too=y

# ==============================================================================
# LuCI 基础组件（Web 后台框架）
# ==============================================================================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-dashboard=y
CONFIG_PACKAGE_luci-mod-firmware=y

# 设置 Argon 为系统默认主题
CONFIG_DEFAULT_luci-theme-argon=y

# ==============================================================================
# 第三方插件清单（仓库已集成，可在本文件中开启/关闭）
# --------------------------------------------------------------------------------
# 注意：本仓库不添加任何代理类插件
# ==============================================================================

# Smart DNS（智能 DNS 解析分流，支持测速择优）
CONFIG_PACKAGE_smartdns=y
CONFIG_PACKAGE_luci-app-smartdns=y

# DDNSTO（内网穿透 / DDNS 远程访问）
CONFIG_PACKAGE_ddnsto=y
CONFIG_PACKAGE_luci-app-ddnsto=y

# AdGuardHome（去广告 + DNS 过滤）
CONFIG_PACKAGE_adguardhome=y
CONFIG_PACKAGE_luci-app-adguardhome=y

# OFA / OAF（应用过滤，基于特征的应用层过滤）
CONFIG_PACKAGE_oaf=y
CONFIG_PACKAGE_luci-app-oaf=y

# TurboAcc 加速（流量加速 / NAT 加速）
CONFIG_PACKAGE_luci-app-turboacc=y
# TurboAcc 子模块：开启 BBR 拥塞控制
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_BBR_CAKE=y
# TurboAcc 子模块：关闭 NATFLOW（按需开启，避免与其它加速冲突）
# CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_NATFLOW is not set

# mwan3（多 WAN 负载均衡 / 策略路由）
CONFIG_PACKAGE_mwan3=y
CONFIG_PACKAGE_luci-app-mwan3=y

# Argon 主题（设为系统默认主题）
CONFIG_PACKAGE_luci-theme-argon=y

# argon-config（Argon 主题在线配置管理）
CONFIG_PACKAGE_luci-app-argon-config=y

# 带宽监控（nlbwmon 网络带宽监控）
CONFIG_PACKAGE_nlbwmon=y
CONFIG_PACKAGE_luci-app-nlbwmon=y

# EasyTier 内网穿透（去中心化组网）
CONFIG_PACKAGE_easytier=y
CONFIG_PACKAGE_luci-app-easytier=y

# ==============================================================================
# 系统运维常用工具（方便使用者在固件内排障，体积可控）
# ==============================================================================
CONFIG_PACKAGE_busybox=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_blockd=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-squashfs=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-cp936=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_kmod-nls-utf8=y
CONFIG_PACKAGE_kmod-loop=y
CONFIG_PACKAGE_kmod-scsi-core=y

# 网络诊断工具
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_iptables=y
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_tcpdump=y

# 时间同步 / 时区
CONFIG_PACKAGE_chrony=y
CONFIG_PACKAGE_luci-app-syncdial=n

# 自动挂载 / 自动共享（按需）
CONFIG_PACKAGE_autocore=y
CONFIG_PACKAGE_autocore-x86=y

# 软件源 / 包管理
CONFIG_PACKAGE_opkg=y
CONFIG_PACKAGE_luci-app-opkg=y

# 中文语言支持
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y

# ==============================================================================
# IPv4 / IPv6 / 防火墙基础
# ==============================================================================
CONFIG_PACKAGE_firewall=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_kmod-ipt-core=y
CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_kmod-nf-iptables=y
CONFIG_PACKAGE_kmod-nf-conntrack6=y
CONFIG_PACKAGE_kmod-ipt-conntrack=y
CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_kmod-ipt-nat6=y
CONFIG_PACKAGE_kmod-ip6tables=y
CONFIG_PACKAGE_ip6tables=y

# DHCP / DNS 基础服务
# 注意：dnsmasq 与 dnsmasq-full 提供相同文件，只能选一个；
# dnsmasq-full 是增强版（支持 DNSSEC 等），SmartDNS/AdGuardHome 依赖 dnsmasq-full
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_luci-proto-ipv6=y

# ==============================================================================
# ★ 显式禁用所有代理/VPN 类插件（仓库规则：不添加任何代理类插件）
# 即使 feeds install -a 从 LEDE 官方源拉取了这些包，defconfig 也不会启用它们
# ==============================================================================
# 清除 ssr-plus 及其全套依赖
# CONFIG_PACKAGE_luci-app-ssr-plus is not set
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks is not set
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowsocksR_Libev_Client is not set
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowsocksR_Libev_Server is not set
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Xray is not set
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_V2ray is not set
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Trojan is not set
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_NaiveProxy is not set
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Hysteria2 is not set
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Kcptun is not set
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Redsocks2 is not set
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowSocks is not set
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowSocksR is not set
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_NetSpeed is not set

# V2ray / Xray
# CONFIG_PACKAGE_v2ray is not set
# CONFIG_PACKAGE_v2ray-core is not set
# CONFIG_PACKAGE_v2ray-geoip is not set
# CONFIG_PACKAGE_v2ray-geosite is not set
# CONFIG_PACKAGE_xray-core is not set

# Shadowsocks
# CONFIG_PACKAGE_shadowsocks-libev is not set
# CONFIG_PACKAGE_shadowsocks-libev-ss-local is not set
# CONFIG_PACKAGE_shadowsocks-libev-ss-redir is not set
# CONFIG_PACKAGE_shadowsocks-libev-ss-server is not set
# CONFIG_PACKAGE_shadowsocks-libev-ss-socks-server is not set
# CONFIG_PACKAGE_luci-app-shadowsocks-libev is not set

# ShadowsocksR
# CONFIG_PACKAGE_shadowsocksr-libev is not set
# CONFIG_PACKAGE_shadowsocksr-libev-ssr-local is not set
# CONFIG_PACKAGE_shadowsocksr-libev-ssr-redir is not set
# CONFIG_PACKAGE_shadowsocksr-libev-ssr-server is not set
# CONFIG_PACKAGE_luci-app-shadowsocksr-libev is not set

# Trojan / NaiveProxy / Hysteria / Kcptun / Redsocks2
# CONFIG_PACKAGE_trojan is not set
# CONFIG_PACKAGE_luci-app-trojan is not set
# CONFIG_PACKAGE_naiveproxy is not set
# CONFIG_PACKAGE_hysteria is not set
# CONFIG_PACKAGE_hysteria2 is not set
# CONFIG_PACKAGE_kcptun-client is not set
# CONFIG_PACKAGE_kcptun-server is not set
# CONFIG_PACKAGE_redsocks2 is not set

# VPN 类（OpenVPN/WireGuard/WireGuard 需保留——WireGuard 是标准 VPN 协议，非代理）
# CONFIG_PACKAGE_openvpn is not set
# CONFIG_PACKAGE_openvpn-openssl is not set
# WireGuard 按需启用（属于合法 VPN 协议，非代理）
CONFIG_PACKAGE_wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-app-wireguard=y

# IPV6 / TPROXY（代理常用内核模块，默认禁用）
# CONFIG_PACKAGE_kmod-ipt-tproxy is not set

# 默认开启网络协议支持
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y

# ==============================================================================
# 编译选项（开发调试用，可关闭以减小体积）
# ==============================================================================
# 关闭调试信息以减小镜像体积
# CONFIG_DEBUG is not set
# 关闭 IPK 包调试符号
# CONFIG_IB is not set
# 关闭 SDK
# CONFIG_SDK is not set
# 关闭自动镜像构建器
# CONFIG_MAKE_TOOLCHAIN is not set
