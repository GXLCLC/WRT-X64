# ================================================================
# OpenWrt / LEDE 固件编译配置文件（.config 种子文件）
# ----------------------------------------------------------------
# 说明：
#   本文件为编译配置种子，工作流会将其复制到 LEDE 源码根目录，
#   执行 make defconfig 后自动补全所有依赖项。
#
#   使用者可在此文件中通过 =y（启用）/ =m（模块）/ =n（禁用）
#   灵活增减插件。修改后提交即可触发重新编译。
#
# 架构：X86_64
# 镜像格式：squashfs combined（仅输出 IMG）
# 叠加层：预留约 2GB 可写空间（/overlay）
# ================================================================

# ================================================================
# 一、目标平台配置
# ================================================================

# 目标架构：x86_64
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

# ================================================================
# 二、镜像与分区配置
# ================================================================

# 镜像文件系统格式：squashfs（只读根文件系统 + 可写 overlay 层）
CONFIG_TARGET_SQUASHFS=y

# rootfs 分区大小（单位 MB）：
#   squashfs 固件约占 300~500MB，剩余空间自动分配给 overlay（rootfs_data）。
#   设为 3072MB（3GB），扣除 squashfs 后 overlay 可用空间约 2.5GB，
#   满足"预留 2GB 可写空间"的要求。
CONFIG_TARGET_ROOTFS_PARTSIZE=3072

# 压缩生成的镜像文件（.img.gz）
CONFIG_TARGET_IMAGES_GZIP=y

# 仅生成 combined 镜像（合并引导+根文件系统的单一 IMG 文件）
# 不生成 VHDX、VMDK 等虚拟化镜像格式（打包阶段仅筛选 .img 文件上传）

# ================================================================
# 三、基础系统组件
# ================================================================

# Web 管理界面 LuCI
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lib-ipkg=y

# 中文语言支持
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y
CONFIG_PACKAGE_luci-i18n-admin-full-zh-cn=y

# 防火墙
CONFIG_PACKAGE_iptables=y
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_firewall=y
CONFIG_PACKAGE_luci-app-firewall=y

# 系统管理工具
CONFIG_PACKAGE_opkg=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-app-package-manager=y

# 网络基础工具
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_udhcpc=y

# 自动挂载与文件系统支持
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-nfs=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_ntfs-3g=y

# ================================================================
# 四、内核驱动配置
# ================================================================

# --- USB 核心驱动 ---
CONFIG_PACKAGE_kmod-usb-core=y          # USB 核心驱动
CONFIG_PACKAGE_kmod-usb2=y              # USB 2.0 EHCI 驱动
CONFIG_PACKAGE_kmod-usb3=y              # USB 3.0 XHCI 驱动
CONFIG_PACKAGE_kmod-usb-ohci=y          # USB 1.1 OHCI 驱动
CONFIG_PACKAGE_kmod-usb-uhci=y          # USB 1.1 UHCI 驱动

# --- USB 存储驱动 ---
CONFIG_PACKAGE_kmod-usb-storage=y       # USB 存储设备支持（U盘等）
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-scsi-core=y         # SCSI 核心驱动（USB存储依赖）

# --- USB 网卡驱动 ---
CONFIG_PACKAGE_kmod-usb-net=y           # USB 网卡核心驱动
CONFIG_PACKAGE_kmod-usb-net-asix=y      # ASIX USB 网卡驱动
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y  # ASIX AX88179 USB 3.0 千兆网卡
CONFIG_PACKAGE_kmod-usb-net-cdcether=y  # CDC Ethernet USB 网卡
CONFIG_PACKAGE_kmod-usb-net-cdc_subset=y
CONFIG_PACKAGE_kmod-usb-net-rtl8150=y   # Realtek RTL8150 USB 网卡
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y   # Realtek RTL8152 USB 千兆网卡

# --- Intel（英特尔）系列网卡驱动 ---
CONFIG_PACKAGE_kmod-e1000=y             # Intel e1000 千兆网卡驱动
CONFIG_PACKAGE_kmod-e1000e=y            # Intel e1000e PCIe 千兆网卡驱动
CONFIG_PACKAGE_kmod-igb=y               # Intel igb 千兆网卡驱动
CONFIG_PACKAGE_kmod-igbvf=y             # Intel igbvf 虚拟功能驱动
CONFIG_PACKAGE_kmod-igc=y               # Intel igc 2.5G 网卡驱动
CONFIG_PACKAGE_kmod-ixgbe=y             # Intel ixgbe 万兆网卡驱动
CONFIG_PACKAGE_kmod-i40e=y              # Intel i40e 万兆网卡驱动（如有）

# --- Realtek（瑞昱）系列网卡驱动 ---
CONFIG_PACKAGE_kmod-r8169=y             # Realtek RTL8169 千兆网卡驱动
CONFIG_PACKAGE_kmod-r8168=y             # Realtek RTL8168 千兆网卡驱动（如有）
CONFIG_PACKAGE_kmod-r8125=y             # Realtek RTL8125 2.5G 网卡驱动（如有）

# --- 其他常见网卡驱动 ---
CONFIG_PACKAGE_kmod-8139too=y           # Realtek RTL8139 百兆网卡驱动
CONFIG_PACKAGE_kmod-8139cp=y
CONFIG_PACKAGE_kmod-tg3=y               # Broadcom Tigon3 网卡驱动
CONFIG_PACKAGE_kmod-forcedeth=y         # nForce 网卡驱动

# --- 无线网卡驱动（USB/PCIe 通用）---
CONFIG_PACKAGE_kmod-mac80211=y
CONFIG_PACKAGE_kmod-cfg80211=y
CONFIG_PACKAGE_kmod-rt2x00-lib=y
CONFIG_PACKAGE_kmod-rt2x00-usb=y
CONFIG_PACKAGE_kmod-rt2800-usb=y
CONFIG_PACKAGE_kmod-ath=y
CONFIG_PACKAGE_kmod-ath9k=y
CONFIG_PACKAGE_kmod-ath9k-common=y
CONFIG_PACKAGE_kmod-ath9k-htc=y
CONFIG_PACKAGE_kmod-ath10k=y
CONFIG_PACKAGE_kmod-carl9170=y
CONFIG_PACKAGE_kmod-iwlwifi=y

# --- 加密与压缩模块 ---
CONFIG_PACKAGE_kmod-crypto-acompress=y
CONFIG_PACKAGE_kmod-lib-crc32c=y

# ================================================================
# 五、第三方插件配置
# ================================================================

# --- Smart DNS（智能 DNS 分流）---
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_smartdns=y
CONFIG_PACKAGE_luci-i18n-smartdns-zh-cn=y

# --- DDNSTO（内网穿透远程访问）---
CONFIG_PACKAGE_luci-app-ddnsto=y
CONFIG_PACKAGE_ddnsto=y
CONFIG_PACKAGE_luci-i18n-ddnsto-zh-cn=y

# --- AdGuardHome（广告过滤 / DNS 拦截）---
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_adguardhome=y
CONFIG_PACKAGE_luci-i18n-adguardhome-zh-cn=y

# --- OFA / OpenAppFilter（应用过滤）---
CONFIG_PACKAGE_luci-app-oaf=y
CONFIG_PACKAGE_luci-i18n-oaf-zh-cn=y

# --- TurboAcc（网络加速 / NAT 转发加速）---
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_luci-i18n-turboacc-zh-cn=y

# --- mwan3（多 WAN 负载均衡）---
CONFIG_PACKAGE_mwan3=y
CONFIG_PACKAGE_luci-app-mwan3=y
CONFIG_PACKAGE_luci-i18n-mwan3-zh-cn=y

# --- 带宽监控（nlbwmon）---
CONFIG_PACKAGE_nlbwmon=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y

# --- EasyTier（内网穿透组网）---
CONFIG_PACKAGE_luci-app-easytier=y
CONFIG_PACKAGE_easytier=y
CONFIG_PACKAGE_luci-i18n-easytier-zh-cn=y

# ================================================================
# 六、主题配置
# ================================================================

# Argon 主题（设为系统默认主题）
CONFIG_PACKAGE_luci-theme-argon=y
# Argon 主题配置器
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y

# ================================================================
# 七、系统辅助工具
# ================================================================

# 定时任务
CONFIG_PACKAGE_cron=y
CONFIG_PACKAGE_cronie=y

# 文件传输
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_curl=y

# 网络诊断工具
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_ip-full=y

# 系统监控
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-nohup=y

# 实时流量监控
CONFIG_PACKAGE_luci-app-statistics=y
CONFIG_PACKAGE_collectd=y

# 进程管理
CONFIG_PACKAGE_htop=y

# U盘 / 硬盘自动挂载
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-filebrowser=y
CONFIG_PACKAGE_luci-i18n-filebrowser-zh-cn=y

# UPnP 自动端口映射
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_miniupnpd=y

# 网络时间同步
CONFIG_PACKAGE_chrony=y

# 唤醒工具（Wake on LAN）
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y
CONFIG_PACKAGE_etherwake=y

# ================================================================
# 八、编译优化选项
# ================================================================

# 使用 ccache 加速重复编译
CONFIG_CCACHE=y

# 构建时显示详细日志
CONFIG_DEVEL=y

# ================================================================
# 注意事项：
# 1. 本仓库不添加任何代理类插件（如 ssr、v2ray、xray 等）。
# 2. 增减插件时，在对应 CONFIG_PACKAGE_ 行将 =y 改为 =n 或注释掉即可。
# 3. 新增不在现有列表的第三方插件，需先在 scripts/feeds_manage.sh
#    中添加对应插件源，再在此处开启 CONFIG_PACKAGE_* =y。
# ================================================================
