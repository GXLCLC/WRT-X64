#
# ImmortalWrt X86_64 云编译配置（源码分支：openwrt-24.10）
# ---------------------------------------------------------------------------
# 用法：本文件在编译前被复制为固件源码根目录的 .config，
#       随后由 `make defconfig` 自动补全依赖、剔除非法项。
#       用户增减插件，只需编辑本文件即可。
#
# 约定：
#   CONFIG_PACKAGE_xxx=y            -> 选中该软件包
#   # CONFIG_PACKAGE_xxx is not set -> 明确不选中该软件包
#   以“#”开头的普通注释行会被 .config 解析器忽略
# ---------------------------------------------------------------------------

#
# ========== 一、目标平台：仅 X86_64 ==========
#
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_Generic=y
CONFIG_TARGET_BOARD="x86"
CONFIG_TARGET_SUBTARGET="64"
CONFIG_TARGET_PROFILE="DEVICE_generic"
CONFIG_TARGET_ARCH_PACKAGES="x86_64"

#
# ========== 二、镜像格式：仅 squashfs combined img，overlay 分区扩增至 2G ==========
#
# 只生成 squashfs 根文件系统
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
# CONFIG_TARGET_ROOTFS_JFFS2 is not set
# CONFIG_TARGET_ROOTFS_UBIFS is not set
# CONFIG_TARGET_ROOTFS_TARGZ is not set

# GRUB 引导（BIOS + EFI），二者均输出 squashfs combined 分区镜像
CONFIG_GRUB_IMAGES=y
CONFIG_GRUB_EFI_IMAGES=y

# 关闭 gzip，产物只保留 .img（不再额外生成 .img.gz）
# CONFIG_TARGET_IMAGES_GZIP is not set

# 关闭其它虚拟磁盘 / ISO 镜像格式，避免产出多余产物
# CONFIG_VMDK_IMAGES is not set
# CONFIG_VDI_IMAGES is not set
# CONFIG_VHDX_IMAGES is not set
# CONFIG_ISO_IMAGES is not set
# CONFIG_QCOW2_IMAGES is not set

# 内核分区 32 MiB（x86 默认值）
CONFIG_TARGET_KERNEL_PARTSIZE=32
# rootfs 分区 2048 MiB —— 即 overlay 可写分区空间扩增至 2G
CONFIG_TARGET_ROOTFS_PARTSIZE=2048
# squashfs 块大小 256 KiB（默认值，保持与源码一致）
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=256

#
# ========== 三、LuCI 基础与默认主题（argon） ==========
#
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-light=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_uhttpd=y

# argon 主题设为系统默认主题
# 注意：luci-light 集合默认依赖 luci-theme-bootstrap，
#       工作流会将其依赖改写为 luci-theme-argon，故此处明确不选 bootstrap。
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y
# CONFIG_PACKAGE_luci-theme-bootstrap is not set

# 时区数据（Asia/Shanghai 需要 zoneinfo 数据支持）
CONFIG_PACKAGE_zoneinfo-asia=y
CONFIG_PACKAGE_zoneinfo-core=y

#
# ========== 四、11 个必选应用插件 ==========
#

# --- 1. SmartDNS（ImmortalWrt 源码自带） ---
CONFIG_PACKAGE_smartdns=y
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_luci-i18n-smartdns-zh-cn=y

# --- 2. DDNSTO 内网穿透（第三方：kenzok8/openwrt-packages，含中文语言包） ---
CONFIG_PACKAGE_ddnsto=y
CONFIG_PACKAGE_luci-app-ddnsto=y
CONFIG_PACKAGE_luci-i18n-ddnsto-zh-cn=y

# --- 3. AdGuardHome（第三方：kenzok8/openwrt-packages） ---
# AdGuardHome 核心程序（linux_amd64 官方二进制）由工作流预置到
# files/usr/bin/AdGuardHome，随固件一起打包，满足“含 adguardhome 核心”。
# 这里刻意不选 CONFIG_PACKAGE_adguardhome：该源码包会额外安装
# /etc/init.d/adguardhome 与 /etc/config/adguardhome，
# 与 luci-app-adguardhome 自带的 /etc/init.d/AdGuardHome 服务重复冲突。
CONFIG_PACKAGE_luci-app-adguardhome=y
# CONFIG_PACKAGE_luci-app-adguardhome_INCLUDE_binary is not set
# CONFIG_PACKAGE_adguardhome is not set

# --- 4. OAF 应用过滤（第三方：destan19/OpenAppFilter，含 kmod-oaf + appfilter 后端） ---
CONFIG_PACKAGE_kmod-oaf=y
CONFIG_PACKAGE_appfilter=y
CONFIG_PACKAGE_luci-app-oaf=y
CONFIG_PACKAGE_luci-i18n-oaf-zh-cn=y
CONFIG_PACKAGE_luci-lib-jsonc=y

# --- 5. TurboAcc 加速（第三方：chenmozhijin/turboacc，适配 firewall4 版本） ---
# 实际写入的 turboacc 目录由 add_turboacc.sh 完成，这里选中其 LuCI 入口与功能开关。
# Shortcut-FE 由工作流输入 include_sfe 控制（默认关闭），关闭时仅保留：
#   软件流量分载（offload）+ 全锥型 NAT（fullcone）+ BBR 拥塞控制
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_luci-i18n-turboacc-zh-cn=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_OFFLOADING=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_BBR_CCA=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_NFT_FULLCONE=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_SHORTCUT_FE=n
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_SHORTCUT_FE_CM=n
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_SHORTCUT_FE_DRV=n

# --- 6. Mwan3 多拨（ImmortalWrt 源码自带） ---
CONFIG_PACKAGE_mwan3=y
CONFIG_PACKAGE_luci-app-mwan3=y
CONFIG_PACKAGE_luci-i18n-mwan3-zh-cn=y

# --- 7 / 8. luci-theme-argon + luci-argon-config 见“三、LuCI 基础与默认主题” ---

# --- 9. 带宽监控 nlbwmon（ImmortalWrt 源码自带） ---
CONFIG_PACKAGE_nlbwmon=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y

# --- 10. EasyTier 去中心化组网（第三方：kenzok8/small-package） ---
# 注意：luci-app-easytier 的依赖里不含 easytier 本体，必须显式选中核心。
CONFIG_PACKAGE_easytier=y
CONFIG_PACKAGE_luci-app-easytier=y
CONFIG_PACKAGE_luci-i18n-easytier-zh-cn=y
CONFIG_PACKAGE_kmod-tun=y

# --- 11. OpenClash（第三方：kenzok8/small-package） ---
# 只集成 OpenClash 一个代理插件，不添加任何其它代理类插件。
# 其运行依赖（dnsmasq-full / ruby / bash / curl / kmod-tun / kmod-inet-diag /
# kmod-nft-tproxy / dnsmasq_full_nftset 等）由包内 config 段自动拉起。
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_ruby=y
CONFIG_PACKAGE_ruby-yaml=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-nft-tproxy=y

#
# ========== 五、内核模块：内置 USB 驱动 + USB 网卡驱动 + 常见有线网卡驱动 ==========
# 说明：所有 kmod 均随当前 openwrt-24.10 源码树（内核 6.6.x）一并编译，
#       不引入任何外部内核 kmod，保证 ABI 严格匹配。
#       若出现 kmod 冲突（例如 rtl8152 上游驱动与 rtl8152-vendor 厂商驱动互斥），
#       采取“移除冲突模块”策略，只保留其中一个。
#

# --- USB 控制器与 USB 存储 ---
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb-hid=y

# --- USB 串口 / 上网卡辅助 ---
CONFIG_PACKAGE_kmod-usb-acm=y
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-wwan=y

# --- USB 网卡驱动 ---
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-asix=y
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y
CONFIG_PACKAGE_kmod-usb-net-rtl8150=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
# 互斥说明：rtl8152（上游内核驱动）与 rtl8152-vendor（厂商驱动）只能二选一，
# 采用 x86 目标默认的厂商驱动版本。
CONFIG_PACKAGE_kmod-usb-net-rtl8152-vendor=y
# CONFIG_PACKAGE_kmod-usb-net-rtl8152 is not set
CONFIG_PACKAGE_kmod-mii=y
CONFIG_PACKAGE_kmod-usb-net-dm9601-ether=y
CONFIG_PACKAGE_kmod-usb-net-sr9700=y

# --- 常见有线网卡驱动（Intel / Realtek / 其它） ---
CONFIG_PACKAGE_kmod-e1000=y
CONFIG_PACKAGE_kmod-e1000e=y
CONFIG_PACKAGE_kmod-igb=y
CONFIG_PACKAGE_kmod-igbvf=y
CONFIG_PACKAGE_kmod-ixgbe=y
CONFIG_PACKAGE_kmod-ixgbevf=y
CONFIG_PACKAGE_kmod-r8101=y
CONFIG_PACKAGE_kmod-r8125=y
CONFIG_PACKAGE_kmod-r8126=y
CONFIG_PACKAGE_kmod-r8168=y
CONFIG_PACKAGE_kmod-8139too=y
CONFIG_PACKAGE_kmod-8139cp=y
CONFIG_PACKAGE_kmod-pcnet32=y
CONFIG_PACKAGE_kmod-vmxnet3=y
CONFIG_PACKAGE_kmod-tg3=y
CONFIG_PACKAGE_kmod-forcedeth=y
CONFIG_PACKAGE_kmod-bnx2=y
# 说明：AMD XGBE 驱动在 openwrt-24.10 源码中不存在（未定义 KernelPackage/xgbe），
#       若强行写入会被 defconfig 静默剔除，故此处不选，也不做 "is not set" 声明。
CONFIG_PACKAGE_kmod-amazon-ena=y

# --- USB 存储可用的文件系统与字符集（便于挂载 U 盘做外置 overlay / 数据盘） ---
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_kmod-nls-utf8=y
CONFIG_PACKAGE_kmod-scsi-core=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y

#
# ========== 六、基础工具（便于排障与日常使用） ==========
#
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_terminfo=y

#
# ========== 七、编译行为 ==========
#
# 关闭“允许部分包编译失败”的宽松模式由工作流以 IGNORE_ERRORS= 显式保证，
# 此处仅声明常规编译参数。
CONFIG_CCACHE=n
