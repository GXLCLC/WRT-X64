#
# ImmortalWrt openwrt-24.10 X86_64 云编译配置
# 仅编译 x86_64 架构，仅生成 squashfs 格式 IMG 镜像，overlay 额外 +2G 可写空间
#

# ===== 目标架构 =====
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

# ===== 基础系统 =====
CONFIG_VERSION_DIST="ImmortalWrt"
CONFIG_VERSION_NUMBER="24.10"
CONFIG_VERSION_PRODUCT="Generic"

# ===== 镜像格式：仅 squashfs，仅 IMG =====
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_EXT4FS=n
CONFIG_TARGET_ROOTFS_JFFS2=n

# ===== 分区：overlay 额外 +2G（默认 160M，+2048M 后为 2208M 可写空间）=====
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_TARGET_ROOTFS_PARTSIZE=2208

# ===== 镜像类型：仅 GRUB combined IMG，不生成 vhdx/vmdk/qcow2/vdi/iso =====
CONFIG_GRUB_IMAGES=y
CONFIG_GRUB_EFI_IMAGES=y
CONFIG_TARGET_IMAGES_GZIP=n
CONFIG_ISO_IMAGES=n
CONFIG_QCOW2_IMAGES=n
CONFIG_VDI_IMAGES=n
CONFIG_VMDK_IMAGES=n
CONFIG_VHDX_IMAGES=n

# ===== 语言 =====
CONFIG_LUCI_LANG_zh_Hans=y

# ===== 主题：argon 设为默认 =====
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

# ===== 插件清单 =====
# SmartDNS（ImmortalWrt 自带）
CONFIG_PACKAGE_smartdns=y
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_luci-i18n-smartdns-zh-cn=y

# AdGuardHome（kenzok8 版本，核心 + luci 面板，展示 Web UI 端口）
CONFIG_PACKAGE_adguardhome=y
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_luci-app-adguardhome_INCLUDE_binary=y

# DDNSTO 内网穿透（前端 + 后端）
CONFIG_PACKAGE_ddnsto=y
CONFIG_PACKAGE_luci-app-ddnsto=y

# OAF 应用过滤（kmod-oaf + luci-app-oaf）
CONFIG_PACKAGE_kmod-oaf=y
CONFIG_PACKAGE_luci-app-oaf=y

# TurboAcc 加速（适配 firewall4）
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-tcp-bbr=y

# Mwan3（ImmortalWrt 自带）
CONFIG_PACKAGE_mwan3=y
CONFIG_PACKAGE_luci-app-mwan3=y
CONFIG_PACKAGE_luci-i18n-mwan3-zh-cn=y

# 带宽监控 nlbwmon（ImmortalWrt 自带）
CONFIG_PACKAGE_nlbwmon=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y

# EasyTier 异地组网
CONFIG_PACKAGE_easytier=y
CONFIG_PACKAGE_luci-app-easytier=y

# OpenClash（唯一代理插件）
CONFIG_PACKAGE_luci-app-openclash=y

# ===== kmod 内核模块：与 openwrt-24.10 源码内核(6.6)匹配 =====
# 内置 USB 驱动（x86 的 EHCI/XHCI 主机控制器已由 generic 内核内建，无需 kmod-usb2/usb3）
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-ch341=y
CONFIG_PACKAGE_kmod-usb-serial-ftdi=y
CONFIG_PACKAGE_kmod-usb-serial-pl2303=y
CONFIG_PACKAGE_kmod-usb-serial-option=y

# USB 网卡驱动
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-asix=y
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_kmod-usb-net-rtl8150=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-smsc95xx=y

# 有线网卡驱动：英特尔 i211(igb)、i225/i226(igc)、e1000e、ixgbe 等
CONFIG_PACKAGE_kmod-igb=y
CONFIG_PACKAGE_kmod-igc=y
CONFIG_PACKAGE_kmod-e1000=y
CONFIG_PACKAGE_kmod-e1000e=y
CONFIG_PACKAGE_kmod-ixgbe=y
CONFIG_PACKAGE_kmod-i40e=y

# 有线网卡驱动：瑞昱 RTL8111 等
# 注：ImmortalWrt x86_64 默认已内置 kmod-r8168（官方驱动），
#     与内核驱动 kmod-r8169 对 RTL8111/RTL8168 支持冲突，故此处仅保留 r8168，不引入 r8169。
CONFIG_PACKAGE_kmod-r8168=y
CONFIG_PACKAGE_kmod-r8125=y
CONFIG_PACKAGE_kmod-r8126=y
CONFIG_PACKAGE_kmod-r8101=y

# 其他常见有线网卡驱动
CONFIG_PACKAGE_kmod-tg3=y
CONFIG_PACKAGE_kmod-forcedeth=y
CONFIG_PACKAGE_kmod-bnx2=y
CONFIG_PACKAGE_kmod-vmxnet3=y
CONFIG_PACKAGE_kmod-8139too=y

# OpenClash / OAF / EasyTier 依赖的内核模块
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-fullcone=y
CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_kmod-nf-reject=y

# ===== 基础网络/文件系统工具 =====
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-certificates=y
