# ==============================================================================
# LEDE X86_64 (Generic / squashfs) 固件编译配置
# 说明：本文件为唯一插件清单来源，增删插件直接改这里即可（第三方包由
#       scripts/05-configure.sh 追加兜底，重复定义无害）
# 目标：x86/64 Generic · squashfs · 根分区 2G · 内核 6.12 · 主题 Argon
# ==============================================================================

# ------------------------------- 目标平台 -------------------------------------
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y
CONFIG_TARGET_BOARD="x86"
CONFIG_TARGET_SUBTARGET="64"
CONFIG_TARGET_PROFILE="DEVICE_generic"
CONFIG_TARGET_ARCH_PACKAGES="x86_64"

# ------------------------------- 镜像格式 -------------------------------------
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_EXT4FS=n
CONFIG_TARGET_ROOTFS_JFFS2=n
CONFIG_TARGET_ROOTFS_UBIFS=n
CONFIG_TARGET_ROOTFS_TARGZ=n
CONFIG_TARGET_ROOTFS_CPIOGZ=n
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_IMAGES_PAD=n
# overlay / 根分区总大小：2048 MiB = 2G
CONFIG_TARGET_ROOTFS_PARTSIZE=2048
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_GRUB_IMAGES=y
CONFIG_GRUB_TIMEOUT="3"
CONFIG_EFI_IMAGES=y
CONFIG_ISO_IMAGES=n
CONFIG_VDI_IMAGES=n
CONFIG_VMDK_IMAGES=n
CONFIG_QCOW2_IMAGES=n

# ------------------------------- LuCI 与中文 ----------------------------------
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# ========================== 预装插件清单（16 项） ==============================
# 1. SmartDNS（Feeds 缺失时由第三方源补漏，含核心 smartdns）
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_smartdns=y
CONFIG_PACKAGE_luci-i18n-smartdns-zh-cn=y
# 2. ddnsto（中文版）
CONFIG_PACKAGE_luci-app-ddnsto=y
CONFIG_PACKAGE_ddnsto=y
CONFIG_PACKAGE_luci-i18n-ddnsto-zh-cn=y
# 3. AdGuardHome（kenzok8 源：面板 + 核心 + 依赖）
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_adguardhome=y
CONFIG_PACKAGE_luci-i18n-adguardhome-zh-cn=y
# 4. OpenAppFilter 应用过滤（含 kmod-oaf 内核模块，由 oaf 包自动带出）
CONFIG_PACKAGE_luci-app-oaf=y
CONFIG_PACKAGE_oaf=y
CONFIG_PACKAGE_open-app-filter=y
CONFIG_PACKAGE_luci-i18n-oaf-zh-cn=y
# 5. Turbo ACC（流量分载 / 全锥形 NAT / BBR；不含 SFE）
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_nft-fullcone=y
CONFIG_PACKAGE_kmod-nft-fullcone=y
CONFIG_PACKAGE_luci-i18n-turboacc-zh-cn=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-tcp-bbr=y
# 6. MWAN3 多拨负载均衡（预设配置已清空）
CONFIG_PACKAGE_luci-app-mwan3=y
CONFIG_PACKAGE_mwan3=y
CONFIG_PACKAGE_luci-i18n-mwan3-zh-cn=y
# 7/8. Argon 主题与配置插件
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y
CONFIG_PACKAGE_luci-theme-argon=y
# 9. Bandix 流量监控（前端 + 后端）
CONFIG_PACKAGE_luci-app-bandix=y
CONFIG_PACKAGE_openwrt-bandix=y
# 10. EasyTier 异地组网（需 kmod-tun）
CONFIG_PACKAGE_luci-app-easytier=y
CONFIG_PACKAGE_easytier=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_luci-i18n-easytier-zh-cn=y
# 11. WOL 网络唤醒
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_wol=y
CONFIG_PACKAGE_etherwake=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y
# 12. UPnP
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_miniupnpd=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
# 13. TTYD 终端
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
# 14. 定时重启
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-i18n-autoreboot-zh-cn=y
# 15. 微信推送
CONFIG_PACKAGE_luci-app-wechatpush=y
CONFIG_PACKAGE_luci-i18n-wechatpush-zh-cn=y
# 16. 带宽监控
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_nlbwmon=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y

# ========================== 网卡 / USB / 存储驱动 ==============================
# 有线网卡：Intel i211(igb)、i225/i226(igc)、e1000/e1000e、RTL8111(r8169)
CONFIG_PACKAGE_kmod-igb=y
CONFIG_PACKAGE_kmod-igc=y
CONFIG_PACKAGE_kmod-e1000=y
CONFIG_PACKAGE_kmod-e1000e=y
CONFIG_PACKAGE_kmod-r8169=y
CONFIG_PACKAGE_kmod-mii=y
# USB 控制器
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb-uhci=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb-ehci=y
CONFIG_PACKAGE_kmod-usb-xhci-hcd=y
CONFIG_PACKAGE_usbutils=y
# USB 网卡
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-subset=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_kmod-usb-net-asix=y
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y
CONFIG_PACKAGE_kmod-usb-net-mcs7830=y
CONFIG_PACKAGE_kmod-usb-net-dm9601-ether=y
# USB 存储与文件系统
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-scsi-core=y
CONFIG_PACKAGE_kmod-scsi-generic=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_blockd=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-msdos=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-nls-utf8=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_luci-app-ksmbd=n

# ------------------------------- 常用工具 -------------------------------------
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_luci-app-package-manager=y
