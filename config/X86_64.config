# ==============================================================
# ImmortalWrt X86_64 云编译配置（openwrt-24.10 分支）
#
#【使用说明】
#   1. 本文件为「增量式」配置，工作流中由 `make defconfig` 自动补全；
#   2. 新增插件：加一行 CONFIG_PACKAGE_<包名>=y
#      （包名须存在于 ImmortalWrt 源码/feeds，或 scripts/feeds_update.sh
#        的第三方来源表中）；
#   3. 移除插件：改成 # CONFIG_PACKAGE_<包名> is not set；
#   4. kmod-* 依赖由 OpenWrt 自动解析，无需手工罗列；
#   5. 本文件中出现过的每一个 CONFIG_PACKAGE_xxx=y 都会被
#      scripts/verify-packages.sh 在编译完成后逐个回查固件清单：
#      只要有一个没进固件，工作流立即失败，绝不放行。
#   6. 非 CONFIG_PACKAGE_ 的「构建系统开关」（TARGET_x86_64、
#      GRUB_EFI_IMAGES、TARGET_ROOTFS_PARTSIZE、LUCI_LANG_zh_Hans、
#      BUILD_LOG 等）由工作流在 `make defconfig` 之后单独复核：
#      任何一项被静默丢弃都会立刻报错终止。
#      非 x86 目标的符号（如 ONIE_INSTALLER_IMAGES）不要往这里写。
# --------------------------------------------------------------

# --------------------------------------------------------------
# 目标平台：x86/64（仅 64 位；BIOS 与 UEFI 主板通用）
# --------------------------------------------------------------
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

# --------------------------------------------------------------
# 镜像格式：仅 squashfs combined IMG（BIOS + UEFI 各一个）
# 不生成 ISO / QCOW2 / VDI / VMDK / VHDX / ONIE 等其它格式
# --------------------------------------------------------------
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
# CONFIG_TARGET_ROOTFS_CPIOGZ is not set
# CONFIG_TARGET_ROOTFS_TARGZ is not set
CONFIG_GRUB_IMAGES=y
CONFIG_GRUB_EFI_IMAGES=y
# CONFIG_ISO_IMAGES is not set
# CONFIG_QCOW2_IMAGES is not set
# CONFIG_VDI_IMAGES is not set
# CONFIG_VMDK_IMAGES is not set
# CONFIG_VHDX_IMAGES is not set
# 说明：ONIE 安装器镜像（ONIE_INSTALLER_IMAGES）只存在于 armsr 等目标，
#       x86 目标没有该配置项，写在这里毫无意义，故不写。
# 压缩由工作流在「分区扩容完成之后」执行，所以这里必须关掉自动 gzip，
# 否则拿到的是 .img.gz，脚本无法对其做分区表手术。
# CONFIG_TARGET_IMAGES_GZIP is not set

# --------------------------------------------------------------
# 分区大小（MB）
#   kernel 分区 32MB；
#   rootfs 分区 2560MB —— squashfs 实际占用约 150~250MB，剩余空间
#   在首次启动时被 fstools 创建为 rootfs_data(/overlay) 并格式化为
#   f2fs，可写空间 ≥2GiB。
#   工作流末尾还会用 scripts/post-build.sh 复核一次实际可写空间，
#   不足 2048MiB 时自动补齐（双保险）。
# --------------------------------------------------------------
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_TARGET_ROOTFS_PARTSIZE=2560

# --------------------------------------------------------------
# 编译加速与排障开关
#   CCACHE     —— C/C++ 编译缓存（工作流会缓存 .ccache 目录）
#   BUILD_LOG  —— 把「每个软件包各自的编译输出」分别写成
#                 logs/package/<feed>/<包名>/compile.txt，失败时
#                 另写 error.txt。这是「编译失败要能明确看出是哪个包、
#                 从哪个仓库来的」的关键：并行编译时主日志是交错的，
#                 没有它就无法定位失败包。工作流在失败时会把 logs/
#                 完整打包上传。
# --------------------------------------------------------------
CONFIG_DEVEL=y
CONFIG_CCACHE=y
CONFIG_BUILD_LOG=y

# --------------------------------------------------------------
# LuCI 基础与简体中文
#   CONFIG_LUCI_LANG_zh_Hans 只打开「中文语言总开关」，
#   真正的翻译文件要靠下方各插件的独立语言包逐个勾选
# --------------------------------------------------------------
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y
# 第三方 LuCI 插件普遍需要的 lua 兼容层
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_default-settings=y
CONFIG_PACKAGE_default-settings-chn=y

# --------------------------------------------------------------
# 主题：Argon（首次启动设为系统默认主题，见 scripts/system-config.sh）
#   luci-theme-argon 自身无独立 po 目录，故无语言包可勾
# --------------------------------------------------------------
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y

# --------------------------------------------------------------
# 代理插件：全固件仅集成 OpenClash 这一个代理类插件
#   来源：ImmortalWrt 官方 luci feed 自带（openwrt-24.10 已收录）
# --------------------------------------------------------------
CONFIG_PACKAGE_luci-app-openclash=y
# 注意：OpenClash 的 LuCI 界面自带中文（源码 po/ 目录只有 es、zh-cn，缺少 zh_Hans），
#       构建系统只会为存在 po/zh_Hans 的插件生成 luci-i18n-*-zh-cn 包，
#       因此 luci-i18n-openclash-zh-cn 这个包并不存在，切勿勾选（勾了会被静默丢弃并导致校验失败）。

# --------------------------------------------------------------
# SmartDNS：DNS 分流解析
#   来源：ImmortalWrt 源码自带（luci feed + packages/net/smartdns）
# --------------------------------------------------------------
CONFIG_PACKAGE_luci-app-smartdns=y
# 注意：ImmortalWrt 24.10 的 luci-app-smartdns 已把 WebUI 合并进主包，
#       Makefile 中不存在 INCLUDE_WebUI 这个选项（写上去会被 defconfig
#       静默丢弃，进而触发 verify-packages.sh 报错），故不写。
CONFIG_PACKAGE_luci-i18n-smartdns-zh-cn=y

# --------------------------------------------------------------
# DDNSTO 内网穿透（第三方，前后端必须配套，缺一不可）
#   前端：linkease/nas-packages-luci   分支 main
#   后端：linkease/nas-packages        分支 master
#   均由 scripts/feeds_update.sh 按显式分支浅克隆
# --------------------------------------------------------------
CONFIG_PACKAGE_luci-app-ddnsto=y
# ddnsto 是后端守护进程，luci-app-ddnsto 的 LUCI_DEPENDS 里带的是
#   +ddnsto +block-mount，二者是「依赖」而非自动拉入，必须显式勾选，
#   否则会装上面板却没有内网穿透主程序。
CONFIG_PACKAGE_ddnsto=y
# 注意：luci-app-ddnsto 的中文翻译放在 po/zh-cn/ 目录下（11 条译文），
#       luci.mk 只会为 po/zh_Hans/ 目录生成 luci-i18n-*-zh-cn 包，
#       po/zh-cn/ 不生成任何语言包 —— 所以 luci-i18n-ddnsto-zh-cn
#       这个包并不存在，切勿勾选。

# --------------------------------------------------------------
# AdGuard Home 去广告
#   来源：kenzok8/openwrt-packages（强制覆盖 ImmortalWrt 自带版）
#     后端核心 adguardhome + LuCI 面板 luci-app-adguardhome 成套拉取；
#     INCLUDE_binary 把核心二进制打进固件，离线可用；
#     LuCI 页面提供「网页管理端口」等完整配置项（Lua CBI + JS 混合
#     面板，故依赖 luci-compat，已在上方勾选）。
#
#   【版本适配】kenzok8 的 Makefile 默认跟最新版 AdGuardHome（当前
#   0.107.79），而它的 go.mod 要求 Go 1.26、且带 tool/ignore 新指令，
#   依赖 quic-go v0.60 又要求 Go 1.25 —— 而 ImmortalWrt 24.10 内置的
#   是 Go 1.23.12 且 GOTOOLCHAIN=local（禁止下载新工具链），必然编译失败。
#   scripts/patch-plugins.sh 会自动把版本对齐到与 Go 1.23 兼容的最新
#   稳定版（当前为 0.107.57）并重算哈希，无需在此文件里干预。
#
#   kenzok8 版内置 adguardhome.zh-cn.lmo 中文翻译，无独立 po 目录，
#   所以没有 luci-i18n-adguardhome-zh-cn 这个包可勾 —— 不要写，
#   写了 defconfig 会静默丢弃，反而触发 verify-packages.sh 报错。
# --------------------------------------------------------------
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_luci-app-adguardhome_INCLUDE_binary=y
CONFIG_PACKAGE_adguardhome=y

# --------------------------------------------------------------
# OAF 应用过滤（第三方：destan19/OpenAppFilter，分支 master）
#   一个仓库里含三个子包，必须全部拉取，缺一个都编译不过：
#     oaf/              -> kmod-oaf      内核模块
#     open-app-filter/  -> appfilter     用户态服务
#     luci-app-oaf/     -> luci-app-oaf  LuCI 面板（依赖前两者）
# --------------------------------------------------------------
CONFIG_PACKAGE_kmod-oaf=y
CONFIG_PACKAGE_appfilter=y
CONFIG_PACKAGE_luci-app-oaf=y
CONFIG_PACKAGE_luci-i18n-oaf-zh-cn=y

# --------------------------------------------------------------
# TurboAcc 加速（第三方：chenmozhijin/turboacc，分支 luci）
#   该分支是适配 firewall4(nftables) 的维护版，无需再自行打补丁。
#   INCLUDE_OFFLOADING  依赖 kmod-nft-offload（24.10 内核包，已内建该包定义）
#   INCLUDE_BBR_CCA     依赖 kmod-tcp-bbr
#   INCLUDE_NFT_FULLCONE 依赖 kmod-nft-fullcone（firewall4 的必需依赖）
#   Shortcut-FE 系列是给高通平台用的，x86 无对应模块，显式关闭，
#   避免拉入与当前内核不匹配的模块。
# --------------------------------------------------------------
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_OFFLOADING=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_BBR_CCA=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_NFT_FULLCONE=y
# CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_SHORTCUT_FE is not set
# CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_SHORTCUT_FE_CM is not set
# CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_SHORTCUT_FE_DRV is not set
# 注意：luci-app-turboacc 的中文翻译放在 po/zh-cn/ 目录下（19 条译文），
#       luci.mk 只会为 po/zh_Hans/ 目录生成 luci-i18n-*-zh-cn 包，
#       po/zh-cn/ 不生成任何语言包 —— 所以 luci-i18n-turboacc-zh-cn
#       这个包并不存在，切勿勾选。

# --------------------------------------------------------------
# Mwan3 多线多拨 / 负载均衡
#   来源：ImmortalWrt 源码自带；默认未配置（见 files/etc/uci-defaults/）
# --------------------------------------------------------------
CONFIG_PACKAGE_luci-app-mwan3=y
CONFIG_PACKAGE_luci-i18n-mwan3-zh-cn=y

# --------------------------------------------------------------
# 带宽监控 nlbwmon
#   来源：ImmortalWrt 源码自带（luci feed + packages/net/nlbwmon）
# --------------------------------------------------------------
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y

# --------------------------------------------------------------
# EasyTier 去中心化异地组网（第三方：EasyTier/luci-app-easytier，分支 main）
#   核心程序 easytier + Web 控制台 LuCI 面板成套拉取
# --------------------------------------------------------------
CONFIG_PACKAGE_luci-app-easytier=y
CONFIG_PACKAGE_easytier=y
CONFIG_PACKAGE_luci-i18n-easytier-zh-cn=y

# --------------------------------------------------------------
# autocore：状态页 CPU 频率 / 温度显示（x86 目标默认已含，此处显式声明）
# --------------------------------------------------------------
CONFIG_PACKAGE_autocore=y

# --------------------------------------------------------------
# DNS：使用完整版 dnsmasq-full
#   （AdGuard Home / SmartDNS / OpenClash 都需要它的完整特性）
# --------------------------------------------------------------
CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq is not set

# --------------------------------------------------------------
# 流量分载 / 拥塞控制内核模块
#   kmod-nft-offload   firewall4 软件流量分载（Turbo ACC 的 Flow Offload）
#   kmod-nft-fullcone  FullCone NAT（firewall4 本身的必需依赖）
#   kmod-tcp-bbr       BBR 拥塞控制算法
#   三者均取自当前 ImmortalWrt 源码内核（6.6），不引入任何外部版本 kmod
# --------------------------------------------------------------
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nft-fullcone=y
CONFIG_PACKAGE_kmod-tcp-bbr=y

# --------------------------------------------------------------
# USB 驱动说明（重要，勿随意添加 kmod-usb-*）
#
#   openwrt-24.10 的 x86/x86_64 目标已把 USB 子系统全部编入内核
#   （target/linux/x86/config-6.6 与 x86/64/config-6.6 中可见）：
#     CONFIG_USB=y            CONFIG_USB_XHCI_HCD=y   USB3 主控
#     CONFIG_USB_EHCI_HCD=y   CONFIG_USB_OHCI_HCD=y   USB2/USB1 主控
#     CONFIG_USB_UHCI_HCD=y   CONFIG_USB_STORAGE=y    USB 存储
#     CONFIG_USB_HID=y        CONFIG_F2FS_FS=y        overlay 用 f2fs
#
#   既然是内建（=y），对应 .ko 根本不会被编译出来，此时再去勾
#   kmod-usb2 / kmod-usb3 / kmod-usb-ohci / kmod-usb-uhci /
#   kmod-usb-storage / kmod-usb-storage-uas / kmod-usb-hid
#   只会得到「配置写了、实际什么都没装」的假象。故本文件一概不写。
#   USB 存储与 USB 键鼠开箱即用，无需任何额外配置。
# --------------------------------------------------------------

# --------------------------------------------------------------
# USB 网卡驱动（均为可加载模块，必须显式勾选）
#
#   【重要更正】网上流传的「x86 目标默认包清单已含 USB 网卡驱动」
#   说法不实。openwrt-24.10 的 x86/64 generic 设备 DEVICE_PACKAGES
#   实际只有 9 个包（已逐个核对 target/linux/x86/image/64.mk）：
#     kmod-amazon-ena  kmod-amd-xgbe  kmod-bnx2      kmod-e1000
#     kmod-dwmac-intel kmod-forcedeth kmod-fs-vfat  kmod-tg3
#     kmod-drm-i915
#   —— USB 网卡驱动一个都不含，asix / ax88179 / rtl8152 之类
#      更不会「默认自带」，必须在本文件显式声明。
#   下列包名已按 package/kernel/linux/modules/usb.mk 逐个核对
#   （注意：不存在 rtl8152-vendor 这个名字，正确的是 usb-net-rtl8152）。
# --------------------------------------------------------------
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-asix=y
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y
CONFIG_PACKAGE_kmod-usb-net-rtl8150=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y

# --------------------------------------------------------------
# 有线网卡驱动（可加载模块，必须显式勾选）
#
#   事实：x86/64 generic 的 DEVICE_PACKAGES 只有上面那 9 个，
#   Intel 板载 i210/i211（igb）、i225/i226（igc）、Realtek 板载
#   RTL8111/8168（r8168）等常见驱动均不在默认清单里，需要在此
#   逐个补上。下列包名已按以下文件逐个核对，全部取自当前源码
#   内核（6.6），不引入任何外部版本 kmod：
#     package/kernel/linux/modules/netdevices.mk —— e1000e / igb / igc
#     package/kernel/r8168                        —— r8168（v8.055.00）
#     package/kernel/r8125                        —— r8125（2.5G）
#   默认清单里已有的 e1000 / tg3 / bnx2 / amd-xgbe / amazon-ena /
#   forcedeth / dwmac-intel / vmxnet3(内核内建) 不再重复声明。
#   若日后需要 10G/40G 网卡，可自行追加（包名均以上方文件为准）：
#     kmod-ixgbe / kmod-ixgbevf（X520/X710）
#     kmod-i40e  / kmod-i40evf （XL710）
#     kmod-igbvf / kmod-r8126 / kmod-r8127 / kmod-r8101
#
#   【冲突规避】kmod-r8168 的 Makefile 里写有
#   PROVIDES:=kmod-r8169，与内核原生 kmod-r8169 争抢同一批
#   PCI ID，同时安装必然有一个拿不到设备。r8168 功能更全
#   （带 LED 配置与中断调优），故保留 r8168、显式排除 r8169，
#   只保留一套驱动，且两者都来自当前源码内核。
# --------------------------------------------------------------
CONFIG_PACKAGE_kmod-e1000e=y
CONFIG_PACKAGE_kmod-igb=y
CONFIG_PACKAGE_kmod-igc=y
CONFIG_PACKAGE_kmod-r8168=y
CONFIG_PACKAGE_kmod-r8125=y
# CONFIG_PACKAGE_kmod-r8169 is not set
