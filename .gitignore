# ============================================
# OpenWrt 云编译仓库 Git 忽略文件
# ============================================

# 编译输出目录（编译产物不纳入版本管理）
bin/
build_dir/
tmp/
staging_dir/

# LEDE 源码目录（由工作流动态拉取，不入库）
lede/

# 系统临时文件
*.log
*.tmp
*.bak
*.swp
*~
.DS_Store
Thumbs.db

# 编辑器配置文件
.vscode/
.idea/

# 本地环境变量文件（防止敏感信息泄露）
.env
.env.local

# 缓存目录
.cache/
