# ---------------------------------------------------------------------------
# 本文件由 WRT-X64 云编译工作流预置，整文件覆盖 dnsmasq 包自带的
# /etc/config/dhcp（该文件位于 package/network/services/dnsmasq/files/dhcp.conf，
# 但 dnsmasq 段里并没有 port 选项；odhcpd.defaults 也只写 dhcp.lan /
# dhcp.odhcpd 段，同样不写 dhcp.dnsmasq 段）。
#
# 为什么需要预置它：
#   luci-app-adguardhome 的重定向逻辑（/etc/init.d/AdGuardHome 的
#   _do_redirect / use_port53 / set_forward_dnsmasq）全部依赖
#   uci get dhcp.@dnsmasq[0].port 来读取 dnsmasq 的实际 DNS 端口：
#     - 若该值取不到（段不存在或段内无 port 选项），use_port53() 会在
#       dnsmasq_port 默认成 53 后直接 return，AdGuardHome 永远拿不到 53 端口；
#     - set_forward_dnsmasq() 写入 127.0.0.1#5553 上游后，
#       dnsmasq 段本身也因缺少 port 而无法正常承接转发。
#   表现就是用户在选择任一“定向模式”并保存后，界面仍显示“未定向”，
#   AdGuardHome 后台可以进入但没有任何查询/拦截信息。
#
# 预置内容：
#   1) dnsmasq 段显式声明 port = 53（dnsmasq 的 DNS 服务端口），
#      使 AdGuardHome 的重定向逻辑有明确的基准值可读写；
#   2) 保留上游默认的 dnsmasq 行为选项（domainneeded / boguspriv /
#      localise_queries / local '/lan/' 等），不改变默认 DNS 行为；
#   3) 保留 dhcp.lan / dhcp.wan 两个默认 DHCP 段，与 odhcpd.defaults
#      写入的内容一致，避免覆盖掉上游默认值。
# ---------------------------------------------------------------------------

config dnsmasq 'dnsmasq'
	option domainneeded '1'
	option boguspriv '1'
	option filterwin2k '0'
	option localise_queries '1'
	option rebind_protection '1'
	option rebind_localhost '1'
	option local '/lan/'
	option domain 'lan'
	option expandhosts '1'
	option min_cache_ttl '3600'
	option use_stale_cache '3600'
	option cachesize '8000'
	option nonegcache '1'
	option authoritative '1'
	option readethers '1'
	option leasefile '/tmp/dhcp.leases'
	option resolvfile '/tmp/resolv.conf.d/resolv.conf.auto'
	option nonwildcard '1'
	option localservice '1'
	option dns_redirect '1'
	option ednspacket_max '1232'
	option filter_aaaa '0'
	option filter_a '0'
	# dnsmasq 的 DNS 监听端口。默认 53，与上游行为一致；
	# 该选项是 AdGuardHome 各重定向模式的读写基准，必须显式存在。
	option port '53'

config dhcp 'lan'
	option interface 'lan'
	option start '100'
	option limit '150'
	option leasetime '12h'

config dhcp 'wan'
	option interface 'wan'
	option ignore '1'
