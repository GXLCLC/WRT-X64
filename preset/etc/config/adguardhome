# ---------------------------------------------------------------------------
# 本文件由 WRT-X64 云编译工作流预置，整文件覆盖 ImmortalWrt 官方
# packages feed 的 adguardhome 包自带的 /etc/config/adguardhome。
#
# 2026-10 升级说明（24.10 → 25.12）：
#   ImmortalWrt 25.12 官方 feeds 已收录 AdGuardHome
#   （immortalwrt/packages @ openwrt-25.12 的 net/adguardhome，
#     immortalwrt/luci @ openwrt-25.12 的 applications/luci-app-adguardhome）。
#   按「优先拉取 ImmortalWrt 源」的策略，AGH 改由官方源提供，
#   不再从 kenzok8/openwrt-packages 第三方仓库拉取。
#   官方包的 UCI schema 与第三方版不同：配置文件为 /etc/config/adguardhome
#   （小写），段名为 config adguardhome 'config'，且不提供
#   redirect / httpport / binpath 等第三方版选项——Web 端口（3000）与
#   DNS 端口（5553）由 AGH 自身的 /etc/adguardhome/adguardhome.yaml 决定。
#
# 按需求约定：
#   enabled = 1 —— AdGuardHome 默认开机自启。核心二进制已随固件打包到
#      /usr/bin/AdGuardHome（官方包编译安装 + files/ 覆盖层预置二进制），
#      enabled=1 时 /etc/init.d/adguardhome 会经 procd 拉起实例，
#      Web 后台（YAML 中 bind_port=3000）直接可访问，
#      解决此前「Web 后台拒绝连接」的问题。
#   config_file / work_dir —— 显式指向官方默认路径，与 preset 的
#      /etc/adguardhome/adguardhome.yaml 对应（init 以此加载配置）。
#   user / group —— 官方包以 adguardhome 用户（853:853） jailed 方式运行，
#      预置保持一致。
#
# 说明：官方 init 不提供「重定向模式」（iptables REDIRECT / dnsmasq 上游
#   自动切换）。需要让 AGH 接管 DNS 时，用户可在 AGH Web 后台修改
#   dns.port 为 53（需同时改 dnsmasq 端口避免冲突），或在
#   /etc/config/dhcp 的 dnsmasq 段手动添加 list server '127.0.0.1#5553'。
# ---------------------------------------------------------------------------

config adguardhome 'config'
	option enabled '1'
	option config_file '/etc/adguardhome/adguardhome.yaml'
	option work_dir '/var/lib/adguardhome'
	option user 'adguardhome'
	option group 'adguardhome'
	option verbose '0'
