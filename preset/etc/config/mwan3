# For full documentation of mwan3 configuration:
# https://openwrt.org/docs/guide-user/network/wan/multiwan/mwan3#mwan3_configuration
#
# ---------------------------------------------------------------------------
# 本文件由 WRT-X64 云编译工作流预置，整文件覆盖 mwan3 包自带默认配置。
#
# 改动原因：mwan3 包默认会写入 wan / wan6 / wanb / wanb6 四个接口，
#           并顺带生成 10 个成员（member）与 5 个策略（policy）。
#           这些默认项与实际环境并不匹配，容易误导首次使用。
#
# 按需求约定：
#   * 接口（config interface）—— 不配置，留空
#   * 成员（config member）   —— 不配置，留空
#   * 策略（config policy）   —— 不配置，留空
#   * 仅保留 mwan3 自带的 3 条默认规则（config rule）
#   接口 / 成员 / 策略由用户首次登录后在
#   「网络 -> MultiWAN 管理器」中按自身线路情况自行添加。
#
# 说明：3 条默认规则的 use_policy 均指向 balanced 策略。
#       策略为空时 mwan3 只会创建一个空的策略链，不会报错、也不会影响
#       正常路由；待用户创建同名（balanced）策略后，规则即自动生效。
# ---------------------------------------------------------------------------

config globals 'globals'
	option mmx_mask '0x3F00'

config rule 'https'
	option sticky '1'
	option dest_port '443'
	option proto 'tcp'
	option use_policy 'balanced'

config rule 'default_rule_v4'
	option dest_ip '0.0.0.0/0'
	option use_policy 'balanced'
	option family 'ipv4'

config rule 'default_rule_v6'
	option dest_ip '::/0'
	option use_policy 'balanced'
	option family 'ipv6'
