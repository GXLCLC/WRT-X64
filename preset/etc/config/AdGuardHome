# ---------------------------------------------------------------------------
# 本文件由 WRT-X64 云编译工作流预置，整文件覆盖 luci-app-adguardhome
# 包自带的 /etc/config/AdGuardHome。
#
# 按需求约定：enabled = 0 —— AdGuardHome 默认不启用，需用户手动启用。
#   （UCI 中 enabled 为 0 时 /etc/init.d/AdGuardHome 会直接跳过启动，
#     仅保留 LuCI 前端入口供用户随时开启）
#
# binpath 显式指向随固件打包的官方核心 /usr/bin/AdGuardHome，
# 使 LuCI 应用无需联网下载核心即可直接启动。
# ---------------------------------------------------------------------------

config AdGuardHome 'AdGuardHome'
	option enabled '0'
	option httpport '3000'
	option redirect 'none'
	option configpath '/etc/AdGuardHome.yaml'
	option workdir '/etc/AdGuardHome'
	option logfile '/tmp/AdGuardHome.log'
	option verbose '0'
	option binpath '/usr/bin/AdGuardHome'
	option upxflag ''
	option user ''
	option group ''
	option advanced_settings '0'
	option gc '0'
	option maxprocs '0'
	option memlimit '0'
